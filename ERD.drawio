                <mxCell id="t_wfr" value="walk_forward_results  ★&#xa;━━━━━━━━━━━━━━━━━&#xa;UQ  (run_id, ticker, label)&#xa;━━━━━━━━━━━━━━━━━&#xa;Swept params: consecutive_periods,&#xa;  call_target, call_time_stop,&#xa;  put_target, put_time_stop&#xa;OOS metrics: avg_expectancy, avg_win_rate,&#xa;  std_expectancy, stability_score&#xa;total_folds · total_trades · selected (bool)&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: param-sweep ★" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
