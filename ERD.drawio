s=1;fontSize=10;align=left;spacingLeft=6;fontStyle=2;" parent="p5_eco__r8" vertex="1"><mxGeometry x="44" width="456" height="22" as="geometry" /></mxCell><mxCell id="p5_sm" value="signal_monitor (live alert engine)&#10;━━━━━━━━━━━━━━━━━&#10;On bar fire:&#10;  1. compute conditions → if cleared, create signal_alerts row&#10;  2. look up exit_config_overrides[(ticker, latest_calibration_date)]&#10;  3. set target/stop/time_stop per CALL or PUT direction&#10;  4. honour disabled_conditions / disabled_directions overrides&#10;━━━━━━━━━━━━━━━━━&#10;CLOSED LOOP: backtest → walk-forward → exit_config_overrides → live monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
