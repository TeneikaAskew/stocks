                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ins_legend" value="Bold solid arrows = REAL FOREIGN KEY (only place in the schema). Both FKs are ON DELETE SET NULL so a deleted report doesn't orphan its history." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#1e8449;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="1720" y="800" width="600" height="110" as="geometry"/>
                </mxCell>

                <!-- Cluster 6: Premarket -->
                <mxCell id="c_pmb" value="⑥ Premarket Analysis &amp; Playbook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#4d7eb8;dashed=0;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="40" y="960" width="1240" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="t_pma" value="premarket_analysis&#xa;━━━━━━━━━━━━━━━━━&#xa;PK  id (bigserial)&#xa;UQ  (analysis_date, ticker)&#xa;━━━━━━━━━━━━━━━━━&#xa;Brief inputs: price · rsi_14 · consecutive_up/down&#xa;signal_status · strat_candle · strat_combo · ftfc_score · ftfc_direction&#xa;change_pct · rvol · bb_* · vol_regime · macd_cross&#xa;orb_recommendation · orb_reason · llm_playbook&#xa;LLM audit: llm_overview · llm_orb_explanation · llm_analysis&#xa;data_as_of · data_freshness_status&#xa;━━━━━━━━━━━━━━━━━&#xa;Outcome resolution (4:30 PM EOD):&#xa;  trigger_price · stop_price · t1 · t2 · t3 (CALL + PUT)&#xa;  hit_ts · reversal_flag · mae_pct · mfe_pct · eod_pnl&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: premarket-brief (insert 8:30 ET),&#xa;  premarket-playbook-resolver ★ (outcome cols 4:30 ET)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d7eb8;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="60" y="995" width="640" height="235" as="geometry"/>
                </mxCell>
                <mxCell id="t_pmah" value="premarket_analysis_history  ★&#xa;━━━━━━━━━━━━━━━━━&#xa;PK  id (bigserial)&#xa;UQ  (analysis_date, ticker, written_at)&#xa;━━━━━━━━━━━━━━━━━&#xa;Mirrors premarket_analysis schema&#xa;Plus: written_at · run_kind · triggered_by · notes&#xa;run_kind ∈ {scheduled, manual, replay, backfill}&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: premarket-brief (every run mode)&#xa;Append-only audit shadow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="720" y="995" width="540" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="e_pma_pmah" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1e8449;strokeWidth=2;dashed=1;" parent="1" source="t_pma" target="t_pmah" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pmb_legend" value="Every brief run writes 1 row to premarket_analysis (canonical, UPSERT) AND 1 row to premarket_analysis_history (append-only). Outcome columns on canonical are populated 8h later by the 4:30 PM resolver, never on history." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="720" y="1190" width="540" height="40" as="geometry"/>
                </mxCell>

                <!-- Cluster 7: Backtest -->
                <mxCell id="c_bt" value="⑦ Backtest (PR #513 ★ + PR #532 ★) — wired by run_id (UUID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;dashed=0;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1300" y="960" width="1060" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="t_btr" value="backtest_reports  ★&#xa;━━━━━━━━━━━━━━━━━&#xa;PK  run_id (UUID)&#xa;━━━━━━━━━━━━━━━━━&#xa;tickers TEXT[] · report_md (rendered)&#xa;total_trades · win_rate · expectancy_pct · sharpe&#xa;created_at&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: backtest, backtest-pipeline ★" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1320" y="995" width="260" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="t_btt" value="backtest_trades  ★&#xa;━━━━━━━━━━━━━━━━━&#xa;UQ  (run_id, ticker, mode, trade_seq)&#xa;━━━━━━━━━━━━━━━━━&#xa;run_id · ticker · mode · trade_seq&#xa;entry/exit_time · direction · entry/exit_price&#xa;exit_reason ∈ {target, stop_loss, time_stop}&#xa;return_pct · mae_pct · mfe_pct · position_size&#xa;score (base, strat, total) · ftfc_score&#xa;conditions_met · orb_trend&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: backtest, backtest-pipeline ★" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1600" y="995" width="260" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="t_bts" value="backtest_sweeps  ★&#xa;━━━━━━━━━━━━━━━━━&#xa;UQ  (run_id, ticker, label)&#xa;━━━━━━━━━━━━━━━━━&#xa;run_id · ticker · label ∈ {1m, 1m+15m, 5m+30m…}&#xa;trades · win_rate · avg_win/loss&#xa;profit_factor · expectancy · max_dd · sharpe&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: backtest-pipeline ★" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
