                    <mxGeometry relative="1" as="geometry"/>
                    <mxCell value="spot price (close)" style="" connectable="0" vertex="1" parent="p2_e1">
                        <mxGeometry x="-0.5" relative="1" as="geometry">
                            <mxPoint as="offset"/>
                        </mxGeometry>
                    </mxCell>
                </mxCell>
                <mxCell id="p2_e2" style="exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b46504;dashed=1;strokeWidth=2;" parent="1" source="p2_rates" target="p2_etfo" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e3" style="endArrow=open;startArrow=open;html=1;edgeStyle=none;rounded=1;strokeColor=#b46504;" parent="1" source="p2_mdi" target="p2_p1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e4" style="endArrow=open;startArrow=open;html=1;edgeStyle=none;rounded=1;strokeColor=#b46504;" parent="1" source="p2_mdi" target="p2_p2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e5" style="endArrow=open;startArrow=open;html=1;edgeStyle=none;rounded=1;strokeColor=#b46504;" parent="1" source="p2_mdi" target="p2_p3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e6" style="endArrow=open;startArrow=open;html=1;edgeStyle=none;rounded=1;strokeColor=#b46504;" parent="1" source="p2_mdi" target="p2_p4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_e7" style="endArrow=open;startArrow=open;html=1;edgeStyle=none;rounded=1;strokeColor=#b46504;" parent="1" source="p2_mdi" target="p2_p5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_note" value="Production note:&#xa;&#xa;• All queries to market_data_intraday go through the parent — Postgres routes to the right partition by ticker. App code does NOT reference the child tables directly.&#xa;&#xa;• etf_options_snapshots Greeks depend on BOTH spot (market_data_daily.close) AND r (daily_rates.dgs3mo_rate). lib/options_greeks.py is the single place this math runs.&#xa;&#xa;• Stale daily_rates → wrong r → wrong Greeks. Audit 2026-05-08 G.P0.7 traced an old delta to a missed FRED fetch — schema does NOT enforce daily_rates freshness; the application must check (data_as_of pattern).&#xa;&#xa;• lib/gamma.py aggregates per-strike GEX → King/Gate/Spot/Flip levels used by premarket-brief + signal-monitor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="460" width="460" height="380" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>

    <diagram name="③ Signals + Premarket" id="erd_p3">
        <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p3_title" value="③ Signals + Premarket — live wire + historical backfill + brief + EOD reconcilers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="30" width="1520" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p3_sa" value="signal_alerts&#xa;━━━━━━━━━━━━━━━━━&#xa;PK id (bigserial)&#xa;━━━━━━━━━━━━━━━━━&#xa;ticker · entry_time · direction · strategy&#xa;score components: base_score + strat_bonus + agreement_bonus,&#xa;  × proximity_multiplier → total score&#xa;rsi/rvol at signal · orb_high/low · brief_bias · brief_alignment&#xa;EXIT (populated 4:30 PM by eod-resolver ★):&#xa;  exit_ts · exit_reason ∈ {target_hit, time_stop, rsi_extreme, eod_close}&#xa;  exit_price · exit_return_pct · is_open&#xa;GATE (insight cross-check):&#xa;  insight_direction · conviction · regime · gate_action · gate_reason&#xa;CATALYST: next/last_catalyst_min · proximity_bucket&#xa;REPLAY: run_kind ∈ {live, replay, backfill} · replay_id&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: signal-monitor (insert),&#xa;  signal-monitor-eod-resolver ★ (exit cols),&#xa;  signal-replay ★ (re-post stored alerts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6abf;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="540" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="p3_hs" value="historical_signals&#xa;━━━━━━━━━━━━━━━━━&#xa;PK (ticker, entry_time, strategy)&#xa;━━━━━━━━━━━━━━━━━&#xa;direction · entry_price · signal_strength · conditions_met (X/5)&#xa;mfe_20m + per-horizon returns: 5/10/15/20/30/45/60 min&#xa;rsi · ema_9 · ema_20 · vwap · volume at entry&#xa;timeframe_tag · expected_hold&#xa;next/last_catalyst_min · proximity_bucket&#xa;extra (JSONB — ORB, order blocks)&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: historical-signals-watchlist (1 AM daily),&#xa;  trading_analysis.py (momentum), signal_monitor.py (mean_reversion)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6abf;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="620" y="80" width="500" height="245" as="geometry"/>
                </mxCell>
                <mxCell id="p3_sm" value="signal_metrics&#xa;━━━━━━━━━━━━━━━━━&#xa;PK (ticker, entry_time, strategy)&#xa;━━━━━━━━━━━━━━━━━&#xa;classification_5m / _15m / _30m / _60m / _90m / _120m / _240m&#xa;  ∈ {CLEAN_HIT, WRONG_DIRECTION, NOISE, MIXED}&#xa;favorable_excursion_pct per horizon&#xa;best_timeframe (fast vs slow winner)&#xa;status ∈ {pending (rolling), final (closed)}&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: signal-quality-report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6abf;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="80" width="400" height="245" as="geometry"/>
                </mxCell>
                <mxCell id="p3_pma" value="premarket_analysis&#xa;━━━━━━━━━━━━━━━━━&#xa;PK id · UQ (analysis_date, ticker)&#xa;━━━━━━━━━━━━━━━━━&#xa;price · rsi_14 · consecutive_up/down · signal_status&#xa;strat_candle · strat_combo · ftfc_score · ftfc_direction&#xa;change_pct · rvol · bollinger · volatility · macd_cross · vol_regime&#xa;orb_recommendation · orb_reason · llm_playbook&#xa;data_as_of · data_freshness_status (CLAUDE.md Rule 3.7)&#xa;LLM audit: llm_overview · llm_orb_explanation · llm_analysis&#xa;OUTCOME (populated 4:30 PM by playbook-resolver ★):&#xa;  CALL/PUT: trigger · stop · t1 · t2 · t3 · hit_ts · reversal_flag&#xa;  mae_pct · mfe_pct · eod_pnl&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: premarket-brief (insert 8:30 ET),&#xa;  premarket-playbook-resolver ★ (outcome 4:30 ET)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d7eb8;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="490" width="700" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="p3_pmah" value="premarket_analysis_history  ★&#xa;━━━━━━━━━━━━━━━━━&#xa;PK id · UQ (analysis_date, ticker, written_at)&#xa;━━━━━━━━━━━━━━━━━&#xa;Mirrors premarket_analysis schema&#xa;+ written_at · run_kind · triggered_by · notes&#xa;run_kind ∈ {scheduled, manual, replay, backfill}&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: premarket-brief (every run mode)&#xa;Append-only — every brief leaves a fingerprint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="780" y="490" width="540" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p3_sl" value="strat_levels&#xa;━━━━━━━━━━━━━━━━━&#xa;PK (ticker, as_of, level_name)&#xa;━━━━━━━━━━━━━━━━━&#xa;Horizontal price markers&#xa;trigger / stop / target / S/R&#xa;strat_class · source_data_as_of · is_current&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: premarket-brief, signal-monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="780" y="710" width="540" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e1" style="endArrow=open;startArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#5b6abf;strokeWidth=2;dashed=1;" parent="1" source="p3_hs" target="p3_sm" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e2" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1e8449;dashed=1;strokeWidth=2;" parent="1" source="p3_pma" target="p3_pmah" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e3" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;dashed=1;" parent="1" source="p3_sl" target="p3_pma" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_e4" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4d7eb8;dashed=1;" parent="1" source="p3_pma" target="p3_sa" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_note" value="Flow: premarket-brief (8:30 ET) writes premarket_analysis canonical row AND a premarket_analysis_history audit row. brief_bias propagates into signal_alerts as an alignment hint. The 4:30 PM resolvers walk RTH 1-min bars from market_data_intraday and populate the outcome columns on the CANONICAL row (premarket_analysis), never on the history shadow." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="880" width="1500" height="100" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>

    <diagram name="④ Insights (FK chain)" id="erd_p4">
        <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p4_title" value="④ Insights cluster — the ONLY place with real FOREIGN KEY constraints" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="30" width="1320" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sub" value="Both FKs are ON DELETE SET NULL — deletes propagate as nullification, never as cascading delete. Audit-trail integrity is preserved." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="64" width="1320" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p4_ir" value="insight_reports&#xa;━━━━━━━━━━━━━━━━━&#xa;PK  id (UUID)&#xa;UQ  (ticker, as_of)&#xa;━━━━━━━━━━━━━━━━━&#xa;ticker · as_of · report (JSONB InsightReport)&#xa;model_versions (JSONB)&#xa;per_role_cost (JSONB) · cost_usd · latency_ms&#xa;created_at&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: insight-pipeline (daily 8:45 ET + on-demand)&#xa;UPSERT on (ticker, as_of) — same day re-run overwrites" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="60" y="130" width="380" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="p4_irun" value="insight_runs&#xa;━━━━━━━━━━━━━━━━━&#xa;PK  id (UUID)&#xa;FK  report_id → insight_reports.id&#xa;     ON DELETE SET NULL&#xa;━━━━━━━━━━━━━━━━━&#xa;status ∈ {queued, running, done, failed}&#xa;trigger ∈ {scheduled, on_demand, local_dev,&#xa;  manual_batch, cache_hit, replay_refresh}&#xa;started_at · finished_at · error&#xa;duration_ms · cost_usd&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: insight-pipeline&#xa;State machine: queued → running → done|failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="500" y="130" width="380" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="p4_irh" value="insight_reports_history  ★&#xa;━━━━━━━━━━━━━━━━━&#xa;PK  id (bigserial)&#xa;FK  insight_run_id → insight_runs.id&#xa;     ON DELETE SET NULL&#xa;UQ  (ticker, as_of, written_at)&#xa;━━━━━━━━━━━━━━━━━&#xa;ticker · as_of · written_at · report (JSONB)&#xa;run_kind ∈ {scheduled, manual, replay,&#xa;  backfill, cache_hit}&#xa;triggered_by · notes&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: insight-pipeline (every run mode)&#xa;Append-only audit log — Phase 1 protection plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="940" y="130" width="380" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="p4_mr" value="model_routing&#xa;━━━━━━━━━━━━━━━━━&#xa;PK  role&#xa;━━━━━━━━━━━━━━━━━&#xa;role ∈ {analyst, bull, bear, judge,&#xa;  trader, risk, portfolio_manager}&#xa;provider ∈ {vertex, anthropic}&#xa;model_name · params (JSONB)&#xa;Trigger: trg_model_routing_updated&#xa;━━━━━━━━━━━━━━━━━&#xa;As of 2026-05-11: all roles → Vertex gemini-3.1-flash-lite&#xa;Writer: manual (seeded in schema migration)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="60" y="450" width="500" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p4_wl" value="watchlists&#xa;━━━━━━━━━━━━━━━━━&#xa;PK (user_id, ticker)&#xa;━━━━━━━━━━━━━━━━━&#xa;in_insight (bool) gates whether ticker shows up&#xa;in /api/insights/watchlist (frontend AI cards)&#xa;Writer: user API · Discord /watchlist · seed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="620" y="450" width="500" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e1" style="endArrow=classic;startArrow=classicThin;html=1;edgeStyle=none;strokeColor=#1e8449;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" parent="1" source="p4_ir" target="p4_irun" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                    <mxCell value="FK report_id" style="" connectable="0" vertex="1" parent="p4_e1">
                        <mxGeometry x="-0.3" relative="1" as="geometry">
                            <mxPoint as="offset"/>
                        </mxGeometry>
                    </mxCell>
                </mxCell>
                <mxCell id="p4_e2" style="endArrow=classic;startArrow=classicThin;html=1;edgeStyle=none;strokeColor=#1e8449;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p4_irun" target="p4_irh" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                    <mxCell value="FK insight_run_id" style="" connectable="0" vertex="1" parent="p4_e2">
                        <mxGeometry x="-0.3" relative="1" as="geometry">
                            <mxPoint as="offset"/>
                        </mxGeometry>
                    </mxCell>
                </mxCell>
                <mxCell id="p4_e3" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1e8449;dashed=1;dashPattern=1 4;" parent="1" source="p4_mr" target="p4_irun" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e4" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;dashed=1;dashPattern=1 4;" parent="1" source="p4_wl" target="p4_ir" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4_note" value="Read this cluster top-to-bottom:&#xa;&#xa;1. User clicks Refresh in /insights → FastAPI POST /api/insights/report/{ticker}/refresh enqueues a Cloud Task.&#xa;2. insight-pipeline Job picks up the task → inserts a row in insight_runs with status=queued, trigger=on_demand.&#xa;3. Job moves status to running, looks up the per-role model in model_routing, calls Vertex/Anthropic.&#xa;4. On success: writes insight_reports row (UPSERT — same (ticker, as_of) overwrites), sets insight_runs.report_id FK to the new id, status=done.&#xa;5. EVERY run (success OR failure) writes a row to insight_reports_history with insight_run_id FK back to the run. The history table&#39;s UQ (ticker, as_of, written_at) prevents duplicates at the same instant.&#xa;&#xa;On report deletion (purge, GDPR-style): the FK SET NULL preserves run + history rows so the audit trail is intact." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="700" width="1260" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>

    <diagram name="⑤ Backtest (PR #513)" id="erd_p5">
        <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p5_title" value="⑤ Backtest cluster — PR #513 (May 2026) — wired by run_id (UUID)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1e8449;" parent="1" vertex="1">
                    <mxGeometry x="40" y="30" width="1520" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p5_sub" value="Three sibling tables share run_id (no real FK; UUID generated by the orchestrator). param-sweep auto-applies winners into exit_config_overrides → live signal-monitor picks them up." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#666;" parent="1" vertex="1">
                    <mxGeometry x="40" y="64" width="1520" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p5_btr" value="backtest_reports  ★&#xa;━━━━━━━━━━━━━━━━━&#xa;PK  run_id (UUID)&#xa;━━━━━━━━━━━━━━━━━&#xa;tickers TEXT[] · report_md (rendered markdown)&#xa;total_trades · win_rate · expectancy_pct · sharpe&#xa;created_at · params (JSONB sweep config)&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: backtest (Discord /backtest 8Gi/8h ★ PR #515),&#xa;  backtest-pipeline ★ (walk-forward orchestrator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="500" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p5_btt" value="backtest_trades  ★&#xa;━━━━━━━━━━━━━━━━━&#xa;UQ (run_id, ticker, mode, trade_seq)&#xa;━━━━━━━━━━━━━━━━━&#xa;run_id (UUID, no FK) · ticker · mode · trade_seq&#xa;entry_time · exit_time · direction&#xa;entry_price · exit_price&#xa;exit_reason ∈ {target, stop_loss, time_stop}&#xa;return_pct · mae_pct · mfe_pct · position_size&#xa;score: base · strat · total · ftfc_score · orb_trend&#xa;conditions_met (comma-joined)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="600" y="120" width="480" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p5_bts" value="backtest_sweeps  ★&#xa;━━━━━━━━━━━━━━━━━&#xa;UQ (run_id, ticker, label)&#xa;━━━━━━━━━━━━━━━━━&#xa;label ∈ {1m, 1m+15m, 5m+30m, …}&#xa;trades · win_rate · avg_win · avg_loss&#xa;profit_factor · expectancy · max_dd · sharpe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="120" width="420" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p5_wfr" value="walk_forward_results  ★&#xa;━━━━━━━━━━━━━━━━━&#xa;UQ (run_id, ticker, label)&#xa;━━━━━━━━━━━━━━━━━&#xa;Swept params:&#xa;  consecutive_periods · call_target · call_time_stop&#xa;  put_target · put_time_stop&#xa;OOS metrics:&#xa;  avg_expectancy · avg_win_rate · std_expectancy&#xa;  stability_score (% folds profitable)&#xa;  total_folds · total_trades&#xa;selected (bool) — true rows promoted to exit_config_overrides&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: param-sweep ★" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="360" width="520" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="p5_eco" value="exit_config_overrides  ★&#xa;━━━━━━━━━━━━━━━━━&#xa;PK (ticker, calibration_date)&#xa;━━━━━━━━━━━━━━━━━&#xa;CALL: target_pct · stop_pct · time_stop_min&#xa;PUT:  target_pct · stop_pct · time_stop_min&#xa;disabled_conditions (JSONB — opt-out conditions)&#xa;disabled_directions (JSONB — [&apos;CALL&apos;] or [&apos;PUT&apos;])&#xa;blue_sky_atr_offset · notes&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: param-sweep ★ (auto-apply selected),&#xa;  manual seed (audit 2026-05-08)&#xa;Read by: signal-monitor, signal-monitor-eod-resolver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="620" y="360" width="500" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="p5_sm" value="signal_monitor (live alert engine)&#xa;━━━━━━━━━━━━━━━━━&#xa;On bar fire:&#xa;  1. compute conditions → if cleared, create signal_alerts row&#xa;  2. look up exit_config_overrides[(ticker, latest_calibration_date)]&#xa;  3. set target/stop/time_stop per CALL or PUT direction&#xa;  4. honour disabled_conditions / disabled_directions overrides&#xa;━━━━━━━━━━━━━━━━━&#xa;CLOSED LOOP: backtest → walk-forward → exit_config_overrides → live monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="360" width="400" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e1" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1e8449;dashed=1;strokeWidth=2;" parent="1" source="p5_btr" target="p5_btt" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                    <mxCell value="run_id" style="" connectable="0" vertex="1" parent="p5_e1">
                        <mxGeometry x="-0.5" relative="1" as="geometry">
                            <mxPoint as="offset"/>
                        </mxGeometry>
                    </mxCell>
                </mxCell>
                <mxCell id="p5_e2" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1e8449;dashed=1;strokeWidth=2;" parent="1" source="p5_btt" target="p5_bts" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e3" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1e8449;dashed=1;strokeWidth=2;" parent="1" source="p5_btr" target="p5_wfr" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5_e4" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1e8449;strokeWidth=3;" parent="1" source="p5_wfr" target="p5_eco" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                    <mxCell value="selected=true → UPSERT" style="" connectable="0" vertex="1" parent="p5_e4">
                        <mxGeometry x="-0.3" relative="1" as="geometry">
                            <mxPoint as="offset"/>
                        </mxGeometry>
                    </mxCell>
                </mxCell>
                <mxCell id="p5_e5" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=3;" parent="1" source="p5_eco" target="p5_sm" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                    <mxCell value="latest calibration_date wins" style="" connectable="0" vertex="1" parent="p5_e5">
                        <mxGeometry x="-0.3" relative="1" as="geometry">
                            <mxPoint as="offset"/>
                        </mxGeometry>
                    </mxCell>
                </mxCell>
                <mxCell id="p5_note" value="Why no FK on run_id across the four backtest tables? Because runs are written by an orchestrator that generates run_id once and fans out — putting an FK on backtest_trades.run_id → backtest_reports.id would require writing the report row FIRST, but the report&#39;s aggregate metrics aren&#39;t known until all trades complete. The UUID-as-correlation-id pattern works because writes are atomic-per-table and the orchestrator guarantees the run_id is unique." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="660" width="1520" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>

    <diagram name="⑥ News + Admin" id="erd_p6">
        <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p6_title" value="⑥ News &amp; Sentiment / Admin &amp; Control" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="30" width="1520" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="p6_news" value="news_sentiment&#xa;━━━━━━━━━━━━━━━━━&#xa;PK id · UQ (ticker, published_ts, url)&#xa;━━━━━━━━━━━━━━━━━&#xa;sentiment_score · relevance_score · overall_sentiment_label&#xa;topics TEXT[] (GIN-indexed for catalyst lookups)&#xa;data_source ∈ {alphavantage, rss, finviz}&#xa;match_method ∈ {direct, title_regex, alias_match, relationship, llm}&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: fetch-news-sentiment,&#xa;  fetch-news-sentiment-earnings, fetch-news-sentiment-topics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="90" width="500" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p6_econ" value="economic_events&#xa;━━━━━━━━━━━━━━━━━&#xa;PK id · UQ (event_date, event_name)&#xa;━━━━━━━━━━━━━━━━━&#xa;event_date · event_name · country · importance&#xa;actual · forecast · previous · source ∈ {ff, fred}&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: fetch-economic-events&#xa;Consumed by: lib.strategies.catalyst_proximity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="580" y="90" width="500" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p6_sec" value="sec_filings&#xa;━━━━━━━━━━━━━━━━━&#xa;PK id · UQ (cik, accession_number)&#xa;━━━━━━━━━━━━━━━━━&#xa;cik · accession_number · ticker (nullable)&#xa;form_type ∈ {8-K, 10-Q, 10-K, 4, …}&#xa;items TEXT[] (GIN; 1.01 M&amp;A, 5.02 exec change)&#xa;filed_ts&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: fetch-sec-filings (4×/day 07/10/13/17 ET)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="90" width="440" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p6_ins" value="insider_transactions&#xa;━━━━━━━━━━━━━━━━━&#xa;PK id&#xa;UQ (ticker, transaction_date, executive,&#xa;     transaction_type, shares, share_price)&#xa;━━━━━━━━━━━━━━━━━&#xa;Form 4 (officer/director/10%-owner buy/sell)&#xa;Ranker clusters 3+ same-dir within 30 days&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: fetch-insider-transactions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="320" width="500" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p6_movers" value="top_movers_daily&#xa;━━━━━━━━━━━━━━━━━&#xa;PK id · UQ (snapshot_date, ticker, category)&#xa;━━━━━━━━━━━━━━━━━&#xa;category ∈ {gainer, loser, most_active}&#xa;pct_change · volume&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: fetch-top-movers (post-close)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="580" y="320" width="500" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p6_ti" value="ticker_info&#xa;━━━━━━━━━━━━━━━━━&#xa;PK ticker&#xa;━━━━━━━━━━━━━━━━━&#xa;name · sector · industry · market_cap · asset_type&#xa;description · raw_json (full AV OVERVIEW)&#xa;relationships JSONB (peers, industry_peers)&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: lib.ticker_info (on first watchlist add)&#xa;Consumer: news_sentiment alias-matching&#xa;Trigger: trg_ticker_info_updated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="320" width="440" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p6_wl" value="watchlists&#xa;━━━━━━━━━━━━━━━━━&#xa;PK (user_id, ticker)&#xa;━━━━━━━━━━━━━━━━━&#xa;user_id (default &apos;default&apos;; future: auth layer)&#xa;added_at · removed_at (NULL = active soft-delete)&#xa;source ∈ {ui, cli, admin, seed}&#xa;in_brief · in_insight · signals (per-surface flags)&#xa;Index: active rows (removed_at IS NULL)&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: user API, Discord /watchlist, seed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="550" width="500" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p6_je" value="journal_entries&#xa;━━━━━━━━━━━━━━━━━&#xa;PK id (UUID)&#xa;━━━━━━━━━━━━━━━━━&#xa;ticker · direction · entry_ts · exit_ts&#xa;entry_price · exit_price · return_pct&#xa;notes (free text)&#xa;embedding vector(768) — pgvector&#xa;  (Vertex text-embedding-005 over notes)&#xa;Trigger: set_journal_updated_at&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: user API&#xa;Used for &apos;find similar past trades&apos; semantic search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="580" y="550" width="500" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p6_tr" value="trades&#xa;━━━━━━━━━━━━━━━━━&#xa;PK id (bigserial)&#xa;━━━━━━━━━━━━━━━━━&#xa;Automated pipeline trades&#xa;Mirrors signal_alerts once positions close&#xa;Realized return_pct, slippage, fees&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: signal-monitor&#xa;Separate from user-authored journal_entries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="550" width="440" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p6_rr" value="ranker_runs&#xa;━━━━━━━━━━━━━━━━━&#xa;PK id (UUID)&#xa;━━━━━━━━━━━━━━━━━&#xa;Decision log for lib.agents.ranker.rank_tickers()&#xa;candidate_count · excluded_count&#xa;weights_used (JSONB) · results (ranked list w/ breakdowns)&#xa;duration_ms · started_at&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: premarket-brief (audit trail)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="740" width="440" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p6_e1" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;dashed=1;dashPattern=1 4;" parent="1" source="p6_ti" target="p6_news" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6_note" value="Notes: news_sentiment uses ticker_info.relationships to alias-match articles that don&#39;t mention the ticker directly (&quot;Apple&quot; → AAPL via name; &quot;TSM&quot; → TSMC via aliases). topics GIN index + economic_events.event_name are the two indexes that drive catalyst-proximity scoring." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="790" width="1040" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
