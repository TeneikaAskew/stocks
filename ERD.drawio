                <mxCell id="t_sl" value="strat_levels&#xa;━━━━━━━━━━━━━━━━━&#xa;PK  (ticker, as_of, level_name)&#xa;━━━━━━━━━━━━━━━━━&#xa;level_type · price · strat_class (e.g. Failed_2U)&#xa;period_label · source_data_as_of (freshness)&#xa;is_current (flag, supersession)&#xa;━━━━━━━━━━━━━━━━━&#xa;Writer: premarket-brief, signal-monitor&#xa;via lib/strat_levels.persist_level_map()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
