                <mxCell id="master_legend" value="LEGEND&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Solid green arrow with bold edges = REAL FOREIGN KEY (only insight_reports → insight_runs → insight_reports_history)&#xa;Dashed orange arrow = semantic join (ticker / date / fiscal_date_ending / run_id)&#xa;Dotted purple arrow = config-driven dependency (model_routing → insight_runs, ticker_calibration ↔ exit_config_overrides)&#xa;★ = added in 2026-05-08 → 2026-05-22 wave (PR #461, #491, #510, #511, #512, #513, #514, #518, #532)&#xa;Greyed-out box = legacy archive_yahoo_* table — not written to in production but retained for forensic queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontStyle=2;fontColor=#555;" parent="1" vertex="1">
