                </mxCell>
                <mxCell id="p5_note" value="Why no FK on run_id across the four backtest tables? Because runs are written by an orchestrator that generates run_id once and fans out — putting an FK on backtest_trades.run_id → backtest_reports.id would require writing the report row FIRST, but the report's aggregate metrics aren't known until all trades complete. The UUID-as-correlation-id pattern works because writes are atomic-per-table and the orchestrator guarantees the run_id is unique." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="850" width="1520" height="80" as="geometry" />
                </mxCell>
            </root>
