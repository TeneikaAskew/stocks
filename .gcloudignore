# .gcloudignore — controls what Cloud Build receives when running gcloud builds submit
# gcp/Dockerfile copies: lib/ gcp/ scripts/ alert_config.json requirements-gcp.txt
# Everything else is excluded to keep Cloud Build uploads small (~5MB vs ~4GB).

# Large market data — migrated to Cloud SQL/GCS via gcp/migrate_to_gcp.py
data/
# ...but the frontend's src/data/ is TypeScript app code — mock modules the
# options components import at build time — NOT pipeline data. The unanchored
# `data/` above (gitignore semantics) would otherwise drop it from the Cloud
# Build upload and break `npm run build` in the image. Mirrors platform/.gitignore.
!platform/src/data/
!platform/src/data/**

# Web apps — deployed separately (GitHub Pages / Firebase)
chart-viewer/
options-heatseeker/
success-report-site/
website/

# Google Apps Script — separate clasp deployment, not part of Cloud Run
google-apps-script/

# Earnings analytics — isolated system with own requirements
earnings_options_analytics/

# Analysis reports — generated outputs, not needed in container
reports/

# Jupyter notebooks
notebooks/
*.ipynb

# Development documentation
docs/

# GitHub Actions CI/CD metadata
.github/

# Development containers and local dev setup
.devcontainer/
# Use anchored paths so platform/Dockerfile is preserved
/Dockerfile
/Dockerfile.claude
docker-compose.yml

# Frontend build artifacts — rebuilt inside the container by the multi-stage Dockerfile
platform/node_modules/
platform/dist/
platform/test-results/
platform/playwright-report/

# Generated venvs / caches anywhere in the tree
**/node_modules/
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Tests — run in CI (GitHub Actions), not in Cloud Run
tests/

# Claude Code settings
.claude/

# Security — never in Cloud Build
.env
*.pem
*.key
*-credentials.json
service-account*.json
