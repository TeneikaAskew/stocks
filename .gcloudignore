# .gcloudignore — controls what Cloud Build receives when running gcloud builds submit
# gcp/Dockerfile copies: lib/ gcp/ scripts/ alert_config.json requirements-gcp.txt
# Everything else is excluded to keep Cloud Build uploads small (~5MB vs ~4GB).

# Large market data — migrated to Cloud SQL/GCS via gcp/migrate_to_gcp.py
# Anchored to the repo root: a bare `data/` (gitignore semantics) also matches
# platform/src/data/ (app source), which silently dropped optionsFlowMock.ts
# from the Cloud Build context and broke `vite build`.
/data/

# Legacy project roots — kept as GUARDS, not because tracked files live here.
# dac85fa4 moved these under archive/, but it moved only TRACKED files: an
# upgraded checkout still holds gitignored leftovers at the old paths
# (google-apps-script/data and earnings_options_analytics/data hold CSVs via
# .gitignore `data/`; success-report-site and website can hold *.log).
# scripts/match_earnings_strategy.py:387 documents and handles exactly that
# case. Without these lines those local files enter the build context, and the
# root Dockerfile's `COPY . .` bakes them into the image.
chart-viewer/
options-heatseeker/
success-report-site/
website/
google-apps-script/
earnings_options_analytics/


# Analysis reports — generated outputs, not needed in container
reports/

# Jupyter notebooks
notebooks/
*.ipynb

# Development documentation
docs/

# GitHub Actions CI/CD metadata
.github/

# Development containers and local dev setup
.devcontainer/
# Use anchored paths so platform/Dockerfile is preserved
/Dockerfile
/Dockerfile.claude
docker-compose.yml

# Frontend build artifacts — rebuilt inside the container by the multi-stage Dockerfile
platform/node_modules/
platform/dist/
platform/test-results/
platform/playwright-report/

# Generated venvs / caches anywhere in the tree
**/node_modules/
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Tests — run in CI (GitHub Actions), not in Cloud Run
tests/

# Claude Code settings
.claude/

# Security — never in Cloud Build
.env
*.pem
*.key
*-credentials.json
service-account*.json
# google-github-actions/auth writes its WIF credential config here in CI
# (see "Generated Credentials Files" in that action's README); without this
# pattern `gcloud builds submit .` ships it in the source archive.
gha-creds-*.json

# Git history — NOT auto-excluded once a .gcloudignore file exists; 5.6 GiB otherwise.
# This alone was making `gcloud builds submit` upload 6.4 GiB per deploy.
.git/

# Archived old apps + large reference assets — not copied into any container image.
archive/
references/
