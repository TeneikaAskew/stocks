                <mxCell id="flows_group" value="Numbered Flow Sequences — follow the arrows in order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;dashed=0;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1240" width="2320" height="220" as="geometry" />
                </mxCell>
                <mxCell id="flow_b" value="🌅 Daily Morning Read (pre-market 7-9am ET)&#10;&#10;1️⃣  7:00 ET — economic-events, insider-transactions populate&#10;2️⃣  19:00 ET prior evening — daily-earnings-refresh-calendar / -history / -reactions&#10;3️⃣  8:20 ET — premarket-refresh polls AV intraday → gap_pct, pre_high/low/vwap&#10;4️⃣  8:30 ET — premarket-brief reads everything → Discord (multi-embed)&#10;5️⃣  8:45 ET — insight-pipeline runs multi-agent AI for SPY/IWM/QQQ&#10;6️⃣  9:15 ET — insight-discord-push posts daily digest&#10;7️⃣  9:25 ET — signal-monitor starts 60s loop until 16:00, posts CALL/PUT alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d7eb8;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="520" y="1280" width="440" height="170" as="geometry" />
                </mxCell>
                <mxCell id="flow_c" value="⚡ On-Demand AI Insight Refresh (Cloud Tasks)&#10;&#10;1️⃣  User clicks &quot;Refresh insight&quot; in solyra React UI&#10;2️⃣  solyra UI → solyra-api-staging (Firebase) or solyra-api-prod (IAP)&#10;3️⃣  platform/api/routers/insights.py POST /refresh enqueues Cloud Tasks&#10;4️⃣  insight-pipeline-queue (max-attempts=2, dispatch=5/s) delivers task&#10;5️⃣  insight-pipeline Job picks up env (INSIGHT_RUN_ID + INSIGHT_TICKER)&#10;6️⃣  Single-ticker pipeline writes one row to insight_reports/insight_runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="980" y="1280" width="440" height="170" as="geometry" />
                </mxCell>
                <mxCell id="flow_d" value="🚨 Failure Notification Pipeline&#10;&#10;1️⃣  Cloud Run Job exits non-zero OR logs severity≥ERROR&#10;2️⃣  gcp-job-failures-sink filters log entry (job_name≠failure-notifier)&#10;3️⃣  Sink writes to gcp-job-failures Pub/Sub topic&#10;4️⃣  gcp-job-failures-push subscription delivers to failure-notifier Cloud Run&#10;5️⃣  Service uses github-pat + github-repo secrets → labeled GitHub issue&#10;&#10;Note: signal-quality-alarm is a deliberate non-zero exit when 7d clean-rate drops 3pp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="1440" y="1280" width="440" height="170" as="geometry" />
                </mxCell>
                <mxCell id="flow_e" value="💬 Discord Slash-Command Path&#10;&#10;1️⃣  Discord sends interaction (e.g. /replay TICKER, /backtest, /validate)&#10;2️⃣  discord-interactions Cloud Run Service receives on port 8080&#10;3️⃣  Service verifies via discord-public-key secret&#10;4️⃣  Service invokes appropriate Cloud Run Job via Run API&#10;     • /replay → backfill-ticker&#10;     • /backtest → backtest (2 GiB)&#10;     • /validate → validate-brief&#10;5️⃣  Triggered Job posts results back to Discord via discord-webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0e8088;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="1900" y="1280" width="440" height="170" as="geometry" />
                </mxCell>
