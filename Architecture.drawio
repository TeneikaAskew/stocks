                <mxCell id="9yM4aQ3hB_Mg5GI6_eAs-109" value="Solid arrow = sync • Dashed = async (Pub/Sub, Tasks) • Dotted = imports lib/ • ↔ = read+write" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#666666;fontStyle=2;" vertex="1" parent="9yM4aQ3hB_Mg5GI6_eAs-1">
