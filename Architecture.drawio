                <mxCell id="lg10" value="Solid arrow = sync • Dashed = async (Pub/Sub, Tasks) • Dotted = imports lib/ • ↔ = read+write" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="1920" y="1168" width="430" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="flows_group" value="Numbered Flow Sequences — follow the arrows in order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;dashed=0;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#222222;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1240" width="2320" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="flow_a" value="🌙 Daily Nightly Write (post-close 11pm ET)&#xa;&#xa;1️⃣  Cloud Scheduler fires fetch-market-data-daily (cron 0 23 * * 1-5)&#xa;2️⃣  Job pulls AlphaVantage TIME_SERIES_DAILY_ADJUSTED for ~25 tickers&#xa;3️⃣  Computes lib/indicators.py → upserts market_data_daily (ON CONFLICT DO UPDATE)&#xa;4️⃣  Parquet snapshot uploaded to GCS raw/&#xa;5️⃣  In parallel: compute-earnings-reactions, evaluate-ew-strikes write derived tables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1280" width="440" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="flow_b" value="🌅 Daily Morning Read (pre-market 7-9am ET)&#xa;&#xa;1️⃣  7:00 ET — economic-events, insider-transactions populate&#xa;2️⃣  7:15 ET — earnings-calendar refreshes today&#39;s reporters&#xa;3️⃣  8:20 ET — premarket-refresh polls AV intraday → gap_pct, pre_high/low/vwap&#xa;4️⃣  8:30 ET — premarket-brief reads everything → Discord (multi-embed)&#xa;5️⃣  8:45 ET — insight-pipeline runs multi-agent AI for SPY/IWM/QQQ&#xa;6️⃣  9:15 ET — insight-discord-push posts daily digest&#xa;7️⃣  9:25 ET — signal-monitor starts 60s loop until 16:00, posts CALL/PUT alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d7eb8;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="520" y="1280" width="440" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="flow_c" value="⚡ On-Demand AI Insight Refresh (Cloud Tasks)&#xa;&#xa;1️⃣  User clicks &quot;Refresh insight&quot; in React dashboard&#xa;2️⃣  Browser → trading-platform Cloud Run Service&#xa;3️⃣  platform/api/routers/insights.py POST /refresh enqueues Cloud Tasks&#xa;4️⃣  insight-pipeline-queue (max-attempts=2, dispatch=5/s) delivers task&#xa;5️⃣  insight-pipeline Job picks up env (INSIGHT_RUN_ID + INSIGHT_TICKER)&#xa;6️⃣  Single-ticker pipeline writes one row to insight_reports/insight_runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="980" y="1280" width="440" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="flow_d" value="🚨 Failure Notification Pipeline&#xa;&#xa;1️⃣  Cloud Run Job exits non-zero OR logs severity≥ERROR&#xa;2️⃣  gcp-job-failures-sink filters log entry (job_name≠failure-notifier)&#xa;3️⃣  Sink writes to gcp-job-failures Pub/Sub topic&#xa;4️⃣  gcp-job-failures-push subscription delivers to failure-notifier Cloud Run&#xa;5️⃣  Service uses github-pat + github-repo secrets → labeled GitHub issue&#xa;&#xa;Note: signal-quality-alarm is a deliberate non-zero exit when 7d clean-rate drops 3pp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="1440" y="1280" width="440" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="flow_e" value="💬 Discord Slash-Command Path&#xa;&#xa;1️⃣  Discord sends interaction (e.g. /replay TICKER, /backtest, /validate)&#xa;2️⃣  discord-interactions Cloud Run Service receives on port 8080&#xa;3️⃣  Service verifies via discord-public-key secret&#xa;4️⃣  Service invokes appropriate Cloud Run Job via Run API&#xa;     • /replay → backfill-ticker&#xa;     • /backtest → backtest (2 GiB)&#xa;     • /validate → validate-brief&#xa;5️⃣  Triggered Job posts results back to Discord via discord-webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0e8088;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="1900" y="1280" width="440" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="addon_group" value="⓫ Cloud Run Jobs &amp; Schema added 2026-05-08 → 2026-05-22 (PR-Linked) — verified against gcp/deploy.sh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#1e8449;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1480" width="2320" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="addon_jobs_title" value="★ New Cloud Run Jobs (11)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#1e8449;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1510" width="500" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="job_smer_a" value="signal-monitor-eod-resolver&#xa;Compute — 4:30 PM ET&#xa;replays intraday, writes&#xa;target_hit/stop_hit/eod_close (PR #512)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1540" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="job_ppr_a" value="premarket-playbook-resolver&#xa;Compute — 4:30 PM ET&#xa;walks RTH bars per (date, ticker)&#xa;writes premarket_analysis_history (PR #511)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e8449;fontSize=9;" parent="1" vertex="1">
