# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Playwright IAP cookie store (interactive auth output)
tests/.auth/

# Playwright run artifacts (regenerated every run — never commit)
test-results/
playwright-report/

# Frontend source under src/data/ is application code, not pipeline data —
# re-include it despite the repo-root `data/` ignore (which targets GCS-backed
# parquet/CSV datasets, not TypeScript modules).
!src/data/
!src/data/**

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
