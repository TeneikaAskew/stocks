# .dockerignore — mirrors .gcloudignore for local docker build runs
# gcp/Dockerfile copies: lib/ gcp/ scripts/ alert_config.json requirements-gcp.txt

# Large market data (anchored — a bare `data/` also matched platform/src/data/)
/data/

# Legacy project roots — kept as GUARDS, not because tracked files live here.
# dac85fa4 moved these under archive/, but it moved only TRACKED files: an
# upgraded checkout still holds gitignored leftovers at the old paths
# (google-apps-script/data and earnings_options_analytics/data hold CSVs via
# .gitignore `data/`; success-report-site and website can hold *.log).
# scripts/match_earnings_strategy.py:387 documents and handles exactly that
# case. Without these lines those local files enter the build context, and the
# root Dockerfile's `COPY . .` bakes them into the image.
chart-viewer/
options-heatseeker/
success-report-site/
website/
google-apps-script/
earnings_options_analytics/

# Everything the move landed under, plus anything future.
archive/

# Analysis reports
reports/

# Jupyter notebooks
notebooks/
*.ipynb

# Development documentation
docs/

# GitHub Actions
.github/

# Git history — 6.4 GB here. Docker NEVER auto-excludes .git from the build
# context (unlike some other tools), so without this line every local
# `docker build` copies the entire history before the first instruction runs.
.git/

# Development containers
.devcontainer/
Dockerfile
Dockerfile.claude
docker-compose.yml

# Reference assets — 26 MB, copied into no image. .gcloudignore has excluded
# this since before the split, so deployed images have never contained it;
# excluding it here makes a local build match production instead of diverging.
references/

# Dependency and virtualenv trees — never part of an image, and large.
# The only node_modules today is under archive/ (already excluded); this is
# the general guard so a future one anywhere is covered too.
**/node_modules/
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Tests
tests/

# Claude Code settings
.claude/

# Security
.env
*.pem
*.key
*-credentials.json
service-account*.json
# WIF credential config google-github-actions/auth writes in CI
gha-creds-*.json
