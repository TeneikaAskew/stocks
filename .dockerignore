# .dockerignore — mirrors .gcloudignore for local docker build runs
# gcp/Dockerfile copies: lib/ gcp/ scripts/ alert_config.json requirements-gcp.txt

# Large market data (anchored — a bare `data/` also matched platform/src/data/)
/data/

# Retired projects — all six of these moved under archive/ (dac85fa4) or were
# removed at the FastAPI cutover. Excluding archive/ covers them and everything
# else that lands there; the per-project lines matched nothing after the move,
# which is why this file silently stopped excluding ~294 MB.
archive/

# Analysis reports
reports/

# Jupyter notebooks
notebooks/
*.ipynb

# Development documentation
docs/

# GitHub Actions
.github/

# Git history — 6.4 GB here. Docker NEVER auto-excludes .git from the build
# context (unlike some other tools), so without this line every local
# `docker build` copies the entire history before the first instruction runs.
.git/

# Development containers
.devcontainer/
Dockerfile
Dockerfile.claude
docker-compose.yml

# Reference assets — 26 MB, copied into no image. .gcloudignore has excluded
# this since before the split, so deployed images have never contained it;
# excluding it here makes a local build match production instead of diverging.
references/

# Dependency and virtualenv trees — never part of an image, and large.
# The only node_modules today is under archive/ (already excluded); this is
# the general guard so a future one anywhere is covered too.
**/node_modules/
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Tests
tests/

# Claude Code settings
.claude/

# Security
.env
*.pem
*.key
*-credentials.json
service-account*.json
# WIF credential config google-github-actions/auth writes in CI
gha-creds-*.json
