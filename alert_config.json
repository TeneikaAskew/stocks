{
  "alerts": {
    "primary_call_alert": {
      "name": "IWM Contrarian CALL Setup",
      "conditions": {
        "time_window": "09:30-10:00",
        "price_vs_vwap": "below",
        "rsi_range": [
          45,
          70
        ],
        "rvol_minimum": 1.5,
        "additional_filters": [
          "ema9_alignment",
          "volume_surge"
        ]
      },
      "message_template": "\ud83d\udfe2 CALL: IWM ${price} | RSI: ${rsi} | RVOL: ${rvol}x | Target: ${target} | Stop: ${stop}",
      "sound": "positive_chime",
      "priority": "high"
    },
    "primary_put_alert": {
      "name": "IWM Contrarian PUT Setup",
      "conditions": {
        "time_window": "09:30-14:00",
        "price_vs_vwap": "above",
        "rsi_range": [
          30,
          55
        ],
        "rvol_minimum": 1.5,
        "additional_filters": [
          "rsi_below_40_preferred",
          "volume_surge"
        ]
      },
      "message_template": "\ud83d\udd34 PUT: IWM ${price} | RSI: ${rsi} | RVOL: ${rvol}x | Target: ${target} | Stop: ${stop}",
      "sound": "alert_chime",
      "priority": "high"
    },
    "exit_alerts": {
      "profit_target_hit": {
        "call_target": "0.30%",
        "put_target": "0.38%",
        "message": "\ud83c\udfaf TARGET HIT: ${return}% profit - EXIT NOW",
        "sound": "success_sound",
        "priority": "urgent"
      },
      "time_stop": {
        "call_minutes": 30,
        "put_minutes": 35,
        "message": "\u23f0 TIME STOP: ${minutes} minutes elapsed - EXIT NOW",
        "sound": "warning_sound",
        "priority": "high"
      },
      "extreme_rsi_exit": {
        "call_rsi_exit": 80,
        "put_rsi_exit": 20,
        "message": "\ud83d\udcca EXTREME RSI ${rsi} - CONSIDER EXIT",
        "sound": "alert_sound",
        "priority": "high"
      }
    },
    "warning_alerts": {
      "poor_trading_time": {
        "trigger_time": "14:00",
        "message": "\u26a0\ufe0f Entering low-probability trading window",
        "frequency": "once_daily"
      },
      "low_volume": {
        "rvol_threshold": 0.5,
        "message": "\u26a0\ufe0f Low volume detected - RVOL: ${rvol}x",
        "frequency": "continuous"
      },
      "high_volatility": {
        "atr_threshold": 0.3,
        "rvol_threshold": 5.0,
        "message": "\u26a1 Extreme volatility - ATR: ${atr} | RVOL: ${rvol}x",
        "frequency": "continuous"
      }
    }
  },
