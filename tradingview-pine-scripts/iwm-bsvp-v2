//@version=6
indicator("IWM BUY & SELL VOLUME PRESSURE v2", shorttitle="BSVP v2", precision=0, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════════

fastMAPeriod = input.int(3, "Base for FastMA Periods:", minval=1)
longPeriod = input.int(27, "Buy to Sell Conv/Div Lookback:", minval=1)
vmacd = input.bool(true, "Buy to Sell Convergence/Div OSC:")
vinv = input.bool(false, "Buy to Sell Conv/Div as cumulative:")
norm = input.bool(false, "Normalised (Filtered) Version:", tooltip="Raw Mode (OFF): Uses direct volume data\nFiltered Mode (ON): Normalizes volume against averages to reduce noise from HFT and day-to-day variations")
barTransparency = input.int(80, "Bar Transparency (0=Solid, 100=Invisible)", minval=0, maxval=100, group="Visual")
showInfoTable = input.bool(true, "Show Info Table", group="Visual")
tablePosition = input.string("Top Left", "Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Visual")
showSignalIcon = input.bool(true, "Show Signal Icon", group="Visual")
tooltipDetail = input.string("Detailed", "Signal Tooltip Detail", options=["Simple", "Detailed", "Expert"], group="Visual")
showSignalLabels = input.bool(true, "Show Buy/Sell Signal Labels", group="Visual")


// Reversal & Trend Strength Settings
showDivergence = input.bool(true, "Show Divergence Signals", group="Advanced Signals")
showTrendStrength = input.bool(true, "Show Trend Strength Background", group="Advanced Signals")
showAcceleration = input.bool(true, "Show Momentum Acceleration Arrows", group="Advanced Signals")
showEntryQuality = input.bool(true, "Show Entry Quality Score", group="Advanced Signals")
divergenceLookback = input.int(14, "Divergence Lookback Period", minval=5, maxval=50, group="Advanced Signals")


// RTH Settings
sessionET = input.session("0930-1600", "Regular Trading Hours (ET)", group="Visual")
alwaysOn = input.bool(false, "Always show labels (override RTH)", group="Visual")

// Color Settings
bullColor = input.color(color.green, "Bullish/Buy Color", group="Colors")
bearColor = input.color(color.red, "Bearish/Sell Color", group="Colors")
neutralColor = input.color(color.gray, "Neutral/Wait Color", group="Colors")
vpo1Color = input.color(color.green, "VPO1 Line Color", group="Colors")
vpo2Color = input.color(color.orange, "VPO2 Signal Line Color", group="Colors")
histogramBullColor = input.color(color.green, "Histogram Bullish Color", group="Colors")
histogramBearColor = input.color(color.red, "Histogram Bearish Color", group="Colors")
histogramTransparency = input.int(50, "Histogram Transparency (0=Solid, 100=Invisible)", minval=0, maxval=100, group="Colors")


// ══════════════════════════════════════════════════════════════════════════════
// RTH CHECK
// ══════════════════════════════════════════════════════════════════════════════

// Compute RTH flag
inRTH = not na(time(timeframe.period, sessionET, "America/New_York"))


// ══════════════════════════════════════════════════════════════════════════════
// DATA QUALITY CHECK
// ══════════════════════════════════════════════════════════════════════════════

// Detect low quality bars (extended hours or low volume)
isExtendedHours = not inRTH
isLowVolume = volume < ta.sma(volume, 20) * 0.3
isNarrowRange = (high - low) < ta.atr(14) * 0.2
lowQualityBar = isExtendedHours or (isLowVolume and isNarrowRange)

// Reduce confidence in signals during low quality periods
signalQualityMultiplier = lowQualityBar ? 0.5 : 1.0

// ══════════════════════════════════════════════════════════════════════════════
// CALCULATIONS (Original Algorithm)
// ══════════════════════════════════════════════════════════════════════════════

vol = volume > 0 ? volume : 1

// Bull And Bear "Power-Balance" by Vadim Gimelfarb Algorithm's
BP = close < open ? (close[1] < open ? math.max(high - close[1], close - low) : math.max(high - open, close - low)) : close > open ? (close[1] > open ? high - low : math.max(open - close[1], high - low)) : high - close > close - low ? (close[1] < open ? math.max(high - close[1], close - low) : high - open) : high - close < close - low ? (close[1] > open ? high - low : math.max(open - close[1], high - low)) : (close[1] > open ? math.max(high - open, close - low) : close[1] < open ? math.max(open - close[1], high - low) : high - low)

SP = close < open ? (close[1] > open ? math.max(close[1] - open, high - low) : high - low) : close > open ? (close[1] > open ? math.max(close[1] - low, high - close) : math.max(open - low, high - close)) : high - close > close - low ? (close[1] > open ? math.max(close[1] - open, high - low) : high - low) : high - close < close - low ? (close[1] > open ? math.max(close[1] - low, high - close) : open - low) : (close[1] > open ? math.max(close[1] - open, high - low) : close[1] < open ? math.max(open - low, high - close) : high - low)

TP = BP + SP

// RAW Pressure Volume Calculations
BPV = (BP/TP) * vol
SPV = (SP/TP) * vol
TPV = BPV + SPV
BPVavg = ta.ema(ta.ema(BPV, fastMAPeriod), fastMAPeriod)
SPVavg = ta.ema(ta.ema(SPV, fastMAPeriod), fastMAPeriod)
TPVavg = ta.ema(ta.wma(TPV, fastMAPeriod), fastMAPeriod)

// Karthik Marar's Pressure Volume Normalized Version
VN = vol / ta.ema(vol, longPeriod)
BPN = ((BP / ta.ema(BP, longPeriod)) * VN) * 100
SPN = ((SP / ta.ema(SP, longPeriod)) * VN) * 100
TPN = BPN + SPN
nbf = ta.ema(ta.wma(BPN, fastMAPeriod), fastMAPeriod)
nsf = ta.ema(ta.wma(SPN, fastMAPeriod), fastMAPeriod)
tpf = ta.ema(ta.wma(TPN, fastMAPeriod), fastMAPeriod)

// Conditional Selectors for RAW/Norm
BPc1 = BPV > SPV ? BPV : -math.abs(BPV)
BPc2 = BPN > SPN ? BPN : -math.abs(BPN)
SPc1 = SPV > BPV ? SPV : -math.abs(SPV)
SPc2 = SPN > BPN ? SPN : -math.abs(SPN)
BPcon = norm ? BPc2 : BPc1
SPcon = norm ? SPc2 : SPc1
BPAcon = norm ? nbf : BPVavg
SPAcon = norm ? nsf : SPVavg
TPAcon = norm ? tpf : TPVavg

// Volume Pressure Convergence Divergence
vpo1 = vinv ? ((math.sum(BPVavg, longPeriod) - math.sum(SPVavg, longPeriod)) / math.sum(TPVavg, longPeriod)) * 100 : ((BPVavg - SPVavg) / TPVavg) * 100
vpo2 = vinv ? ((math.sum(nbf, longPeriod) - math.sum(nsf, longPeriod)) / math.sum(tpf, longPeriod)) * 100 : ((nbf - nsf) / tpf) * 100
vph = nz((vpo1 - vpo2), 0)


// ══════════════════════════════════════════════════════════════════════════════
// v2: EMA9/EMA20 COMPUTATIONS
// ══════════════════════════════════════════════════════════════════════════════

ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)

// EMA cross direction
emaCrossUp = ta.crossover(ema9, ema20)
emaCrossDown = ta.crossunder(ema9, ema20)
emaBullish = ema9 > ema20
emaBearish = ema9 < ema20
emaCrossDir = emaBullish ? "BULL" : emaBearish ? "BEAR" : "FLAT"


// ══════════════════════════════════════════════════════════════════════════════
// v2: RSI EXTREME ZONES
// ══════════════════════════════════════════════════════════════════════════════

rsiVal = ta.rsi(close, 14)
rsiExtremeBull = rsiVal < 30
rsiExtremeBear = rsiVal > 70


// ══════════════════════════════════════════════════════════════════════════════
// v2: STOCHRSI LEADING SIGNAL
// ══════════════════════════════════════════════════════════════════════════════

stochK = ta.stoch(rsiVal, rsiVal, rsiVal, 14)
stochD = ta.sma(stochK, 3)

// Early warning conditions: fires 1-5 bars BEFORE VPO cross
stochLeadBull = ta.crossover(stochK, stochD) and stochK < 30
stochLeadBear = ta.crossunder(stochK, stochD) and stochK > 70


// ══════════════════════════════════════════════════════════════════════════════
// v2: VOLATILITY REGIME DETECTION
// ══════════════════════════════════════════════════════════════════════════════

atrVal = ta.atr(14)
atrSma50 = ta.sma(atrVal, 50)
highVol = atrVal > atrSma50 * 1.5
lowVol = atrVal < atrSma50 * 0.7
normalVol = not highVol and not lowVol
volRegime = highVol ? "HIGH" : lowVol ? "LOW" : "NORMAL"


// ══════════════════════════════════════════════════════════════════════════════
// v2: TIME-OF-DAY QUALITY MULTIPLIER
// ══════════════════════════════════════════════════════════════════════════════

morningPrime = not na(time(timeframe.period, "0930-1030", "America/New_York"))
mainSession = not na(time(timeframe.period, "1030-1400", "America/New_York"))
afternoon = not na(time(timeframe.period, "1400-1600", "America/New_York"))

timeMultiplier = morningPrime ? 1.2 : mainSession ? 1.0 : afternoon ? 0.7 : 1.0
sessionPhase = morningPrime ? "MORNING PRIME" : mainSession ? "MAIN SESSION" : afternoon ? "AFTERNOON" : "PRE/POST"


// ══════════════════════════════════════════════════════════════════════════════
// DIVERGENCE DETECTION
// ══════════════════════════════════════════════════════════════════════════════

// Price peaks and troughs
priceHigh = ta.highest(high, divergenceLookback)
priceLow = ta.lowest(low, divergenceLookback)
priceAtHigh = high == priceHigh
priceAtLow = low == priceLow

// Volume pressure peaks and troughs
bullPressureHigh = ta.highest(BPAcon, divergenceLookback)
sellPressureHigh = ta.highest(SPAcon, divergenceLookback)

// Bearish Divergence: Price making higher high but bull pressure declining
bearishDiv = priceAtHigh and BPAcon < BPAcon[1] and BPAcon < BPAcon[2] and vpo1 > 0
bearishDivConfirmed = bearishDiv and vph < vph[1]

// Bullish Divergence: Price making lower low but sell pressure declining
bullishDiv = priceAtLow and SPAcon < SPAcon[1] and SPAcon < SPAcon[2] and vpo1 < 0
bullishDivConfirmed = bullishDiv and vph > vph[1]

// Hidden Divergence (continuation patterns)
hiddenBullDiv = priceAtHigh and vpo1 > vpo1[divergenceLookback/2] and vpo1 > 0
hiddenBearDiv = priceAtLow and vpo1 < vpo1[divergenceLookback/2] and vpo1 < 0

// ══════════════════════════════════════════════════════════════════════════════
// MOMENTUM ACCELERATION
// ══════════════════════════════════════════════════════════════════════════════

// Rate of change in volume pressure
bullAccel = ta.roc(BPAcon, 3)
sellAccel = ta.roc(SPAcon, 3)
vpo1Accel = ta.roc(vpo1, 3)

// Exhaustion signals (high pressure but decelerating)
bullExhaustion = BPAcon > ta.sma(BPAcon, 20) and bullAccel < -15 and vpo1 > 0
sellExhaustion = SPAcon > ta.sma(SPAcon, 20) and sellAccel < -15 and vpo1 < 0

// Early acceleration signals (building momentum)
bullAccelerating = BPAcon > SPAcon and bullAccel > 20 and vpo1Accel > 0
sellAccelerating = SPAcon > BPAcon and sellAccel > 20 and vpo1Accel < 0

// Momentum shift detection
momentumShift = (vph > 0 and vph[1] <= 0) or (vph < 0 and vph[1] >= 0)


// ══════════════════════════════════════════════════════════════════════════════
// TREND STRENGTH SCORE (0-100)
// ══════════════════════════════════════════════════════════════════════════════

var float trendStrength = 0.0

// Factor 1: Volume pressure dominance (40 points)
vpDominance = math.abs((BPAcon - SPAcon) / (BPAcon + SPAcon)) * 100
vpScore = vpDominance > 70 ? 40 : vpDominance > 50 ? 30 : vpDominance > 30 ? 20 : 10

// Factor 2: Convergence strength (30 points)
vpo1Strength = math.abs(vpo1)
convScore = vpo1Strength > 30 ? 30 : vpo1Strength > 15 ? 20 : vpo1Strength > 5 ? 10 : 5

// Factor 3: Histogram momentum (30 points)
vphStrength = math.abs(vph)
histScore = vphStrength > 10 ? 30 : vphStrength > 5 ? 20 : vphStrength > 2 ? 10 : 5

trendStrength := vpScore + convScore + histScore

// Trend quality assessment
trendQuality = trendStrength > 75 ? "STRONG" : trendStrength > 50 ? "MODERATE" : trendStrength > 30 ? "WEAK" : "CHOPPY"

// ══════════════════════════════════════════════════════════════════════════════
// SIGNAL CALCULATIONS
// ══════════════════════════════════════════════════════════════════════════════

// Calculate variables for info table and tooltip
ratio = math.round((BPV / (BPV + SPV)) * 100)
trend = vpo1 > 0 ? "BULL" : "BEAR"
momentum = vph > 0 ? "+" : "-"
momentumValue = str.tostring(math.abs(vph), "#.#")

// Generate signals
// buySignal = BPcon > 0 and vpo1 > 0 and vpo1 > vpo2
// sellSignal = SPcon > 0 and vpo1 < 0 and vpo1 < vpo2

// // Enhanced buy/sell signals with quality check
// buySignal = BPcon > 0 and vpo1 > 0 and vpo1 > vpo2 and not bearishDivConfirmed
// sellSignal = SPcon > 0 and vpo1 < 0 and vpo1 < vpo2 and not bullishDivConfirmed

// Enhanced extended hours check for buy/sell signals with quality check
buySignal = (alwaysOn or inRTH) and BPcon > 0 and vpo1 > 0 and vpo1 > vpo2 and not bearishDivConfirmed and not lowQualityBar
sellSignal = (alwaysOn or inRTH) and SPcon > 0 and vpo1 < 0 and vpo1 < vpo2 and not bullishDivConfirmed and not lowQualityBar

// v2: RSI Extreme alignment with volume pressure direction
rsiExtremeBuyAligned = rsiExtremeBull and buySignal
rsiExtremeSellAligned = rsiExtremeBear and sellSignal


// Alert signal calculations
// strongBuy = BPcon > 0 and BPcon > BPcon[1] and vpo1 > 0 and vpo1 > vpo2 and vph > 0
// strongSell = SPcon > 0 and SPcon > SPcon[1] and vpo1 < 0 and vpo1 < vpo2 and vph < 0

// Update existing strongBuy/strongSell to incorporate new factors
// strongBuy = BPcon > 0 and BPcon > BPcon[1] and vpo1 > 0 and vpo1 > vpo2 and vph > 0 and not bearishDiv
// strongSell = SPcon > 0 and SPcon > SPcon[1] and vpo1 < 0 and vpo1 < vpo2 and vph < 0 and not bullishDiv

// Enhanced extended hours check for strongBuy/strongSell to incorporate RTH filter
strongBuy = (alwaysOn or inRTH) and BPcon > 0 and BPcon > BPcon[1] and vpo1 > 0 and vpo1 > vpo2 and vph > 0 and not bearishDiv
strongSell = (alwaysOn or inRTH) and SPcon > 0 and SPcon > SPcon[1] and vpo1 < 0 and vpo1 < vpo2 and vph < 0 and not bullishDiv


bullCross = ta.crossover(vpo1, vpo2) and vpo1 > 0
bearCross = ta.crossunder(vpo1, vpo2) and vpo1 < 0

tradeSignal = buySignal ? "BUY" : sellSignal ? "SELL" : "WAIT"


// ══════════════════════════════════════════════════════════════════════════════
// ENTRY QUALITY SCORE (0-100) — v2: 5 factors, rescaled with time multiplier
// ══════════════════════════════════════════════════════════════════════════════

var float entryQuality = 0.0

// Factor 1: Trend strength (30 points)
trendScore = trendStrength > 75 ? 30 : trendStrength > 50 ? 20 : trendStrength > 30 ? 10 : 0

// Factor 2: Momentum acceleration (25 points)
accelScore = (bullAccelerating or sellAccelerating) ? 25 : momentumShift ? 15 : 0

// Factor 3: No divergence warning (20 points)
divScore = not bearishDiv and not bullishDiv ? 20 : 10

// Factor 4: Volume pressure alignment (25 points)
alignScore = (BPcon > 0 and vpo1 > 0 and vpo1 > vpo2) or (SPcon > 0 and vpo1 < 0 and vpo1 < vpo2) ? 25 : 10

// Factor 5: EMA confirmation (20 points) — v2 addition
float emaScore = 0.0
if buySignal
    emaScore := close > ema9 ? 20 : close > ema20 ? 10 : 0
else if sellSignal
    emaScore := close < ema9 ? 20 : close < ema20 ? 10 : 0
else
    emaScore := 0

// v2: StochRSI leading signal bonus (10 points when aligned)
float stochLeadBonus = 0.0
if buySignal and stochLeadBull
    stochLeadBonus := 10
else if sellSignal and stochLeadBear
    stochLeadBonus := 10

// Raw total: max = 30+25+20+25+20+10 = 130, but original 4 factors max = 100, new max = 140
// Rescale to 0-100: multiply by 100/140
rawScore = trendScore + accelScore + divScore + alignScore + emaScore + stochLeadBonus

// Apply signal quality multiplier AND time-of-day multiplier, then rescale
entryQuality := math.min((rawScore * 100.0 / 140.0) * signalQualityMultiplier * timeMultiplier, 100)

// Add quality warning
dataQuality = lowQualityBar ? "LOW (Extended Hours)" : "HIGH (RTH)"


// Entry timing assessment
entryTiming = entryQuality > 70 ? "PRIME" : entryQuality > 50 ? "GOOD" : entryQuality > 30 ? "WAIT" : "AVOID"

// Late entry warning
lateEntry = (buySignal or sellSignal) and trendStrength > 70 and not (bullAccelerating or sellAccelerating)
earlyEntry = (buySignal or sellSignal) and (bullAccelerating or sellAccelerating) and entryQuality > 70

// Prime entry signals (high quality setups)
// primeBuy = buySignal and earlyEntry and not bullExhaustion
// primeSell = sellSignal and earlyEntry and not sellExhaustion

// Enhanced extended hours check forPrime entry signals (high quality setups)
primeBuy = buySignal and earlyEntry and not bullExhaustion and inRTH
primeSell = sellSignal and earlyEntry and not sellExhaustion and inRTH


// Add these after the Entry Quality Score section:
plot(trendStrength, "Trend Strength", color=color.new(color.yellow, 0), display=display.status_line)
plot(entryQuality, "Entry Quality", color=color.new(color.aqua, 0), display=display.status_line)

// ══════════════════════════════════════════════════════════════════════════════
// TOOLTIP GENERATION — v2: includes EMA, RSI, StochRSI, Volatility info
// ══════════════════════════════════════════════════════════════════════════════

signalTooltip = ""
if tooltipDetail == "Simple"
    signalTooltip := "Volume Pressure: " + (BPcon > 0 ? "Bullish" : "Bearish") + "\n" + "Convergence: " + (vpo1 > 0 ? "Bullish" : "Bearish") + " (" + str.tostring(vpo1, "#.#") + "%)"
else if tooltipDetail == "Detailed"
    // Determine current trading action
    currentSignal = rsiExtremeBuyAligned ? "EXTREME BUY" : rsiExtremeSellAligned ? "EXTREME SELL" : buySignal ? "STRONG CALL BUY" : sellSignal ? "STRONG PUT BUY" : (BPcon > 0 and vpo1 > 0) ? "WEAK CALL BIAS" : (SPcon > 0 and vpo1 < 0) ? "WEAK PUT BIAS" : "WAIT/FLAT"

    // Check alerts - NEW SECTION!
    alertText = ""
    if strongBuy
        alertText := alertText + "STRONG BUY ALERT\n"
    if strongSell
        alertText := alertText + "STRONG SELL ALERT\n"
    if bullCross
        alertText := alertText + "BULL CONVERGENCE CROSS\n"
    if bearCross
        alertText := alertText + "BEAR CONVERGENCE CROSS\n"
    if stochLeadBull
        alertText := alertText + "STOCHRSI LEAD BULL (early warning)\n"
    if stochLeadBear
        alertText := alertText + "STOCHRSI LEAD BEAR (early warning)\n"

    // Add detailed breakdown of why alerts may not be active
    breakdown = ""

    // Show what's needed for strong buy when in any bullish situation
    if (BPcon > 0 and vpo1 > 0) and not strongBuy
        breakdown := breakdown + "STRONG BUY needs:\n"
        breakdown := breakdown + (BPcon > BPcon[1] ? "[Y]" : "[N]") + " Buying pressure increasing\n"
        breakdown := breakdown + (vpo1 > vpo2 ? "[Y]" : "[N]") + " Convergence above signal line\n"
        breakdown := breakdown + (vph > 0 ? "[Y]" : "[N]") + " Histogram positive\n"

    // Show what's needed for strong sell when in any bearish situation
    if (SPcon > 0 and vpo1 < 0) and not strongSell
        breakdown := breakdown + "STRONG SELL needs:\n"
        breakdown := breakdown + (SPcon > SPcon[1] ? "[Y]" : "[N]") + " Selling pressure increasing\n"
        breakdown := breakdown + (vpo1 < vpo2 ? "[Y]" : "[N]") + " Convergence below signal line\n"
        breakdown := breakdown + (vph < 0 ? "[Y]" : "[N]") + " Histogram negative\n"

    if alertText == ""
        alertText := "No alerts currently active" + (breakdown != "" ? "\n" + breakdown : "")
    else
        alertText := alertText + (breakdown != "" ? breakdown : "")

    signalTooltip := "=== TRADING ACTION ===\n" + currentSignal + "\n-----------------\nVolume Pressure: " + (BPcon > 0 ? "Bullish" : "Bearish") + "\nConvergence: " + (vpo1 > 0 ? "Bullish" : "Bearish") + " (" + str.tostring(vpo1, "#.#") + "%)\nSignal Line: " + str.tostring(vpo2, "#.#") + "%\nHistogram: " + str.tostring(vph, "#.#") + "\n-----------------\nEMA9/20: " + emaCrossDir + " | RSI: " + str.tostring(rsiVal, "#.#") + "\nSession: " + sessionPhase + " | Vol Regime: " + volRegime + "\n-----------------\n" + (buySignal ? "ENTRY: Buy calls now\nEXIT: When convergence peaks" : sellSignal ? "ENTRY: Buy puts now\nEXIT: When convergence bottoms" : (vpo1 > vpo2 and vph > 0) ? "WAIT: Call setup building\nWATCH: For volume confirmation" : (vpo1 < vpo2 and vph < 0) ? "WAIT: Put setup building\nWATCH: For volume confirmation" : "FLAT: No clear direction\nWAIT: For better setup") + "\n-----------------\nCONFLUENCE ALERTS:\n" + alertText
else
    // Expert tooltip — v2: includes EMA, RSI, StochRSI, volatility regime details
    signalTooltip := "=== FULL ANALYSIS ===\n" + "Buy Pressure: " + str.tostring(math.round(BPV)) + " (" + str.tostring(ratio) + "%)\n" + "Sell Pressure: " + str.tostring(math.round(SPV)) + " (" + str.tostring(100-ratio) + "%)\n" + "Convergence (VPO1): " + str.tostring(vpo1, "#.##") + "%\n" + "Signal Line (VPO2): " + str.tostring(vpo2, "#.##") + "%\n" + "Histogram: " + str.tostring(vph, "#.##") + "\n" + "-----------------\n" + "Mode: " + (norm ? "Filtered (normalized data)" : "Raw (direct volume data)") + "\n" + "-----------------\n" + "EMA9: " + str.tostring(ema9, "#.##") + " | EMA20: " + str.tostring(ema20, "#.##") + "\n" + "EMA Cross: " + emaCrossDir + (emaCrossUp ? " (JUST CROSSED UP)" : emaCrossDown ? " (JUST CROSSED DOWN)" : "") + "\n" + "RSI(14): " + str.tostring(rsiVal, "#.#") + (rsiExtremeBull ? " [OVERSOLD]" : rsiExtremeBear ? " [OVERBOUGHT]" : "") + "\n" + "StochRSI K/D: " + str.tostring(stochK, "#.#") + "/" + str.tostring(stochD, "#.#") + (stochLeadBull ? " [LEAD BULL]" : stochLeadBear ? " [LEAD BEAR]" : "") + "\n" + "-----------------\n" + "Volatility Regime: " + volRegime + "\n" + "ATR(14): " + str.tostring(atrVal, "#.##") + " | ATR SMA50: " + str.tostring(atrSma50, "#.##") + "\n" + "ATR Ratio: " + str.tostring(atrVal / atrSma50, "#.##") + "x\n" + "-----------------\n" + "Session: " + sessionPhase + " (x" + str.tostring(timeMultiplier, "#.#") + ")\n" + "Entry Quality: " + str.tostring(entryQuality, "#") + "/100 (" + entryTiming + ")\n" + "Trend Strength: " + str.tostring(trendStrength, "#") + "/100 (" + trendQuality + ")\n" + "-----------------\n" + "Entry Conditions:\n" + "  Volume confirms direction\n" + "  Convergence aligns\n" + "  Histogram momentum positive\n" + "  EMA9/20 confirms trend\n" + "  RSI not at extreme against trade"

// ══════════════════════════════════════════════════════════════════════════════
// PLOTTING
// ══════════════════════════════════════════════════════════════════════════════

// Color definitions

// Bar Colors using user inputs
Vpo1C = vpo1 >= 0 ? bullColor : bearColor
Vpo2C = vpo2Color
histC = vph >= 0 ? histogramBullColor : histogramBearColor

// Volume Pressure Bars
plot(vmacd ? na : SPcon, color=color.new(color.red, barTransparency), title="SELLING", style=plot.style_columns, linewidth=3, display=display.all)
