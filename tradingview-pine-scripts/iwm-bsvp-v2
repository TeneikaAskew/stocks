    table.cell(infoTable, 1, 7, volRegimeText, text_color=volRegimeColor, bgcolor=color.new(color.black, 0), text_size=size.normal)

    // v2: Session Phase with Time Multiplier
    table.cell(infoTable, 0, 8, "Session", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.normal)
    sessionColor = morningPrime ? color.lime : mainSession ? color.white : afternoon ? color.orange : color.gray
    sessionText = sessionPhase + " (x" + str.tostring(timeMultiplier, "#.#") + ")"
    table.cell(infoTable, 1, 8, sessionText, text_color=sessionColor, bgcolor=color.new(color.black, 0), text_size=size.normal)

