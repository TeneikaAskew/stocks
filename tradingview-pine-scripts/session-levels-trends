            lPW50 := line.new(bar_index, pw50, bar_index, pw50, extend=extend.right, color=color.new(colPW_input, 60), width=2, style=line.style_dashed)

        // Update tracked values
        prev_pwh := pwh
        prev_pwl := pwl
        prev_pwc := pwc

    // Update labels on last bar (so they stay on the right edge)
    if barstate.islast
        lblPWH := deleteLabel(lblPWH)
        lblPWL := deleteLabel(lblPWL)
        lblPWC := deleteLabel(lblPWC)
        lblPW50 := deleteLabel(lblPW50)

        lblPWH := label.new(bar_index + 10, pwh, "PWH", style=label.style_label_left, color=colPW, textcolor=color.white, size=size.tiny)
        lblPWL := label.new(bar_index + 10, pwl, "PWL", style=label.style_label_left, color=colPW_f, textcolor=color.white, size=size.tiny)
        lblPWC := label.new(bar_index + 10, pwc, "PWC", style=label.style_label_left, color=colPC, textcolor=color.white, size=size.tiny)

        if show50Pct
            pw50 = (pwh + pwl) / 2
            lblPW50 := label.new(bar_index + 10, pw50, "PW 50%", style=label.style_label_left, color=color.new(colPW_input, 60), textcolor=color.white, size=size.tiny)

// Pre-Market High/Low tracking
if newDay
    pmHigh := na
    pmLow := na

if showPmM and isPremkt and not na(pmH)
    pmHigh := na(pmHigh) ? pmH : math.max(pmHigh, pmH)
    pmLow := na(pmLow) ? pmL : math.min(pmLow, pmL)

// Draw Pre-Market levels - only recreate if values changed
if showPmM and not na(pmHigh) and not na(pmLow)
    pmmChanged = pmHigh != prev_pmHigh or pmLow != prev_pmLow

    if pmmChanged or na(lPmMH)
        // Delete old lines
        lPmMH := deleteLine(lPmMH)
        lPmML := deleteLine(lPmML)
        lPmM50 := deleteLine(lPmM50)

        // Create new lines (once)
        lPmMH := line.new(bar_index, pmHigh, bar_index, pmHigh, extend=extend.right, color=colPmM, width=2, style=line.style_solid)
        lPmML := line.new(bar_index, pmLow, bar_index, pmLow, extend=extend.right, color=colPmM_f, width=2, style=line.style_solid)

        // Draw 50% midpoint level
        if show50Pct
            pmm50 = (pmHigh + pmLow) / 2
            lPmM50 := line.new(bar_index, pmm50, bar_index, pmm50, extend=extend.right, color=color.new(colPmM_input, 60), width=2, style=line.style_dashed)

        // Update tracked values
        prev_pmHigh := pmHigh
        prev_pmLow := pmLow

    // Update labels on last bar (so they stay on the right edge)
    if barstate.islast
        lblPmMH := deleteLabel(lblPmMH)
        lblPmML := deleteLabel(lblPmML)
        lblPmM50 := deleteLabel(lblPmM50)

        lblPmMH := label.new(bar_index + 10, pmHigh, "PmMH", style=label.style_label_left, color=colPmM, textcolor=color.white, size=size.tiny)
        lblPmML := label.new(bar_index + 10, pmLow, "PmML", style=label.style_label_left, color=colPmM_f, textcolor=color.white, size=size.tiny)

        if show50Pct
            pmm50 = (pmHigh + pmLow) / 2
            lblPmM50 := label.new(bar_index + 10, pmm50, "PmM 50%", style=label.style_label_left, color=color.new(colPmM_input, 60), textcolor=color.white, size=size.tiny)

// Gap Zone tracking
if newDay
    todayOpen := na
    gapFilled := false
    if not na(gapBox)
        box.delete(gapBox)
        gapBox := na

if showGaps and firstBarRegular and not na(pdc)
    todayOpen := open
    if todayOpen != pdc
        float gapTop = math.max(todayOpen, pdc)
        float gapBot = math.min(todayOpen, pdc)
        gapBox := box.new(bar_index, gapTop, bar_index, gapBot,
                         bgcolor=colGapUn, border_color=na)

if showGaps and not na(gapBox) and not gapFilled
    box.set_right(gapBox, bar_index)
    float gapTop = box.get_top(gapBox)
    float gapBot = box.get_bottom(gapBox)
    
    if low <= gapBot and high >= gapTop
        gapFilled := true
        box.set_bgcolor(gapBox, colGapOk)
        if barstate.islast
            label.delete(lblGapFilled)
            lblGapFilled := label.new(bar_index + 10, (gapTop + gapBot)/2, "Gap Filled",
                     style=label.style_label_left, color=colGapOk,
                     textcolor=color.black, size=size.tiny)

// Psychological levels (round numbers)
if showPsych
    baseLevel = math.round(close / psychStep) * psychStep
    for i = -psychWin to psychWin
        psychLevel = baseLevel + i * psychStep
        line.new(bar_index - 1, psychLevel, bar_index, psychLevel, 
                 extend=extend.right, color=colPsych, width=1, style=line.style_dotted)

