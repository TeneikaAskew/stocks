// Session flags
isPremkt   = not na(time(timeframe.period, premktSession))
isRegular  = not na(time(timeframe.period, regularSession))
wasRegular = not na(time(timeframe.period, regularSession)[1])
firstBarRegular = isRegular and not wasRegular

// Previous Day/Week/Month levels with SESSION filter option
string tickerSrc = useRTHOnly ? ticker.new(syminfo.prefix, syminfo.ticker, session.regular) : syminfo.tickerid
pdh = request.security(tickerSrc, "D", high,  barmerge.gaps_off, barmerge.lookahead_off)[1]
pdl = request.security(tickerSrc, "D", low,   barmerge.gaps_off, barmerge.lookahead_off)[1]
pdc = request.security(tickerSrc, "D", close, barmerge.gaps_off, barmerge.lookahead_off)[1]
pwh = request.security(tickerSrc, "W", high,  barmerge.gaps_off, barmerge.lookahead_off)[1]
pwl = request.security(tickerSrc, "W", low,   barmerge.gaps_off, barmerge.lookahead_off)[1]
pwc = request.security(tickerSrc, "W", close, barmerge.gaps_off, barmerge.lookahead_off)[1]
pmoh = request.security(tickerSrc, "M", high,  barmerge.gaps_off, barmerge.lookahead_off)[1]
pmol = request.security(tickerSrc, "M", low,   barmerge.gaps_off, barmerge.lookahead_off)[1]
pmoc = request.security(tickerSrc, "M", close, barmerge.gaps_off, barmerge.lookahead_off)[1]

// Get pre-market data using security() - works even if chart is RTH only
string tickerETH = ticker.new(syminfo.prefix, syminfo.ticker, session.extended)
[pmH, pmL] = request.security(tickerETH, timeframe.period, [high, low], barmerge.gaps_off, barmerge.lookahead_off)

