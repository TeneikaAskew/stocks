// Persistent variables for ORB
var line lORBH = na
var line lORBL = na
var box orbBox = na
var float orbHigh = na
var float orbLow = na
var int orbStartBar = na
var int orbEndBar = na
var bool orbComplete = false
var bool orbBrokenUp = false
var bool orbBrokenDown = false
var label lblORBHigh = na
var label lblORBLow = na

// Calculate minutes since regular session open (for time period mode)
var int regularOpenTime = na
if firstBarRegular
    regularOpenTime := time

int minutesSinceOpen = na
if not na(regularOpenTime) and isRegular
    minutesSinceOpen := int((time - regularOpenTime) / 60000)

// Reset ORB on new day
if newDay
    orbHigh := na
    orbLow := na
    orbStartBar := na
    orbEndBar := na
    orbComplete := false
    orbBrokenUp := false
    orbBrokenDown := false
    regularOpenTime := na
    if not na(lORBH)
        line.delete(lORBH)
        lORBH := na
    if not na(lORBL)
        line.delete(lORBL)
        lORBL := na
    if not na(orbBox)
        box.delete(orbBox)
        orbBox := na

// Track ORB - FIRST BAR ONLY MODE
if showORB and orbType == "First Bar Only" and firstBarRegular
    orbHigh := high
    orbLow := low
    orbStartBar := bar_index
    orbEndBar := bar_index
    orbComplete := true

// Track ORB - TIME PERIOD MODE
if showORB and orbType == "Time Period" and isRegular and not na(minutesSinceOpen)
    if minutesSinceOpen <= orbMinutes
        if na(orbStartBar)
            orbStartBar := bar_index
        
        orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
        orbLow := na(orbLow) ? low : math.min(orbLow, low)
        orbEndBar := bar_index
    else if not orbComplete and not na(orbHigh) and not na(orbLow)
        orbComplete := true

// Draw ORB lines and box
if showORB and orbComplete and not na(orbHigh) and not na(orbLow)
    // Draw ORB High line
    if na(lORBH)
        lORBH := line.new(orbEndBar, orbHigh, bar_index, orbHigh,
                         extend=extend.right, color=colORB, width=2, style=line.style_solid)
    else
        line.set_x2(lORBH, bar_index)
        line.set_color(lORBH, orbBrokenUp ? colORBUp : colORB)
    
    // Draw ORB Low line
    if na(lORBL)
        lORBL := line.new(orbEndBar, orbLow, bar_index, orbLow,
                         extend=extend.right, color=colORB_f, width=2, style=line.style_solid)
    else
        line.set_x2(lORBL, bar_index)
        line.set_color(lORBL, orbBrokenDown ? colORBDown : colORB_f)
    
    // Draw ORB box (shaded area)
    if na(orbBox)
        orbBox := box.new(left=orbStartBar, right=orbEndBar,
                         top=orbHigh, bottom=orbLow,
                         bgcolor=colORBBox, border_color=colORB, border_width=1)
    
    // Add labels on last bar - FIXED
    if barstate.islast
        label.delete(lblORBHigh)
        label.delete(lblORBLow)
        lblORBHigh := label.new(bar_index + 10, orbHigh, "ORB High",
                 style=label.style_label_left, color=colORB,
                 textcolor=color.black, size=size.tiny)
        lblORBLow := label.new(bar_index + 10, orbLow, "ORB Low",
                 style=label.style_label_left, color=colORB_f,
                 textcolor=color.black, size=size.tiny)

// Detect ORB breakouts
if showORB and showORBBreaks and orbComplete and not na(orbHigh) and not na(orbLow)
    // Breakout above ORB High
    if not orbBrokenUp and close > orbHigh
        orbBrokenUp := true
        label.new(bar_index, low, "ORB ↑",
                 style=label.style_label_up, color=colORBUp,
                 textcolor=color.black, size=size.small, yloc=yloc.belowbar)
    
    // Breakdown below ORB Low
    if not orbBrokenDown and close < orbLow
        orbBrokenDown := true
        label.new(bar_index, high, "ORB ↓",
                 style=label.style_label_down, color=colORBDown,
                 textcolor=color.black, size=size.small, yloc=yloc.abovebar)

