var label lblPmML = na
var label lblPmM50 = na
var label lblGapFilled = na

// Helper function to delete line if it exists
deleteLine(line l) =>
    if not na(l)
        line.delete(l)
    line(na)

// Helper function to delete label if it exists
deleteLabel(label l) =>
    if not na(l)
        label.delete(l)
    label(na)

// Draw Previous Day levels - only recreate if values changed
if showPD
    pdChanged = pdh != prev_pdh or pdl != prev_pdl or pdc != prev_pdc

    if pdChanged or na(lPDH)
        // Delete old lines
        lPDH := deleteLine(lPDH)
        lPDL := deleteLine(lPDL)
        lPDC := deleteLine(lPDC)
        lPD50 := deleteLine(lPD50)

        // Create new lines (once)
        lPDH := line.new(bar_index, pdh, bar_index, pdh, extend=extend.right, color=colPD, width=2, style=line.style_solid)
        lPDL := line.new(bar_index, pdl, bar_index, pdl, extend=extend.right, color=colPD_f, width=2, style=line.style_solid)
        lPDC := line.new(bar_index, pdc, bar_index, pdc, extend=extend.right, color=colPC, width=2, style=line.style_solid)

        // Draw 50% midpoint level
        if show50Pct
            pd50 = (pdh + pdl) / 2
            lPD50 := line.new(bar_index, pd50, bar_index, pd50, extend=extend.right, color=color.new(colPD_input, 60), width=2, style=line.style_dashed)

        // Update tracked values
        prev_pdh := pdh
        prev_pdl := pdl
        prev_pdc := pdc

    // Update labels on last bar (so they stay on the right edge)
    if barstate.islast
        lblPDH := deleteLabel(lblPDH)
        lblPDL := deleteLabel(lblPDL)
        lblPDC := deleteLabel(lblPDC)
        lblPD50 := deleteLabel(lblPD50)

        lblPDH := label.new(bar_index + 10, pdh, "PDH", style=label.style_label_left, color=colPD, textcolor=color.white, size=size.tiny)
        lblPDL := label.new(bar_index + 10, pdl, "PDL", style=label.style_label_left, color=colPD_f, textcolor=color.white, size=size.tiny)
        lblPDC := label.new(bar_index + 10, pdc, "PDC", style=label.style_label_left, color=colPC, textcolor=color.white, size=size.tiny)

        if show50Pct
            pd50 = (pdh + pdl) / 2
            lblPD50 := label.new(bar_index + 10, pd50, "PD 50%", style=label.style_label_left, color=color.new(colPD_input, 60), textcolor=color.white, size=size.tiny)

// Draw Previous Month levels - only recreate if values changed
if showPMO
    pmoChanged = pmoh != prev_pmoh or pmol != prev_pmol or pmoc != prev_pmoc

    if pmoChanged or na(lPMOH)
        // Delete old lines
        lPMOH := deleteLine(lPMOH)
        lPMOL := deleteLine(lPMOL)
        lPMOC := deleteLine(lPMOC)
        lPMO50 := deleteLine(lPMO50)

        // Create new lines (once)
        lPMOH := line.new(bar_index, pmoh, bar_index, pmoh, extend=extend.right, color=colPMO, width=2, style=line.style_solid)
        lPMOL := line.new(bar_index, pmol, bar_index, pmol, extend=extend.right, color=colPMO_f, width=2, style=line.style_solid)
        lPMOC := line.new(bar_index, pmoc, bar_index, pmoc, extend=extend.right, color=colPC, width=2, style=line.style_solid)

        // Draw 50% midpoint level
        if show50Pct
            pmo50 = (pmoh + pmol) / 2
            lPMO50 := line.new(bar_index, pmo50, bar_index, pmo50, extend=extend.right, color=color.new(colPMO_input, 60), width=2, style=line.style_dashed)

        // Update tracked values
        prev_pmoh := pmoh
        prev_pmol := pmol
        prev_pmoc := pmoc

    // Update labels on last bar (so they stay on the right edge)
    if barstate.islast
        lblPMOH := deleteLabel(lblPMOH)
        lblPMOL := deleteLabel(lblPMOL)
        lblPMOC := deleteLabel(lblPMOC)
        lblPMO50 := deleteLabel(lblPMO50)

