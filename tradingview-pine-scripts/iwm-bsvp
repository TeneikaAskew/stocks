//@version=6
indicator("IWM BUY & SELL VOLUME PRESSURE", shorttitle="BSVP", precision=0, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════════

fastMAPeriod = input.int(3, "Base for FastMA Periods:", minval=1)
longPeriod = input.int(27, "Buy to Sell Conv/Div Lookback:", minval=1)
vmacd = input.bool(true, "Buy to Sell Convergence/Div OSC:")
vinv = input.bool(false, "Buy to Sell Conv/Div as cumulative:")
norm = input.bool(false, "Normalised (Filtered) Version:", tooltip="Raw Mode (OFF): Uses direct volume data\nFiltered Mode (ON): Normalizes volume against averages to reduce noise from HFT and day-to-day variations")
barTransparency = input.int(80, "Bar Transparency (0=Solid, 100=Invisible)", minval=0, maxval=100, group="Visual")
showInfoTable = input.bool(true, "Show Info Table", group="Visual")
tablePosition = input.string("Top Left", "Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Visual")
showSignalIcon = input.bool(true, "Show Signal Icon (💡)", group="Visual")
tooltipDetail = input.string("Detailed", "Signal Tooltip Detail", options=["Simple", "Detailed", "Expert"], group="Visual")
showSignalLabels = input.bool(true, "Show Buy/Sell Signal Labels", group="Visual")


// Reversal & Trend Strength Settings
showDivergence = input.bool(true, "Show Divergence Signals", group="Advanced Signals")
showTrendStrength = input.bool(true, "Show Trend Strength Background", group="Advanced Signals")
showAcceleration = input.bool(true, "Show Momentum Acceleration Arrows", group="Advanced Signals")
showEntryQuality = input.bool(true, "Show Entry Quality Score", group="Advanced Signals")
divergenceLookback = input.int(14, "Divergence Lookback Period", minval=5, maxval=50, group="Advanced Signals")


// RTH Settings
sessionET = input.session("0930-1600", "Regular Trading Hours (ET)", group="Visual")
alwaysOn = input.bool(false, "Always show labels (override RTH)", group="Visual")

// Color Settings
bullColor = input.color(color.green, "Bullish/Buy Color", group="Colors")
bearColor = input.color(color.red, "Bearish/Sell Color", group="Colors")
neutralColor = input.color(color.gray, "Neutral/Wait Color", group="Colors")
vpo1Color = input.color(color.green, "VPO1 Line Color", group="Colors")
vpo2Color = input.color(color.orange, "VPO2 Signal Line Color", group="Colors")
histogramBullColor = input.color(color.green, "Histogram Bullish Color", group="Colors")
histogramBearColor = input.color(color.red, "Histogram Bearish Color", group="Colors")
histogramTransparency = input.int(50, "Histogram Transparency (0=Solid, 100=Invisible)", minval=0, maxval=100, group="Colors")  // ← ADD THIS LINE


// ══════════════════════════════════════════════════════════════════════════════
// RTH CHECK
// ══════════════════════════════════════════════════════════════════════════════

// Compute RTH flag
inRTH = not na(time(timeframe.period, sessionET, "America/New_York"))


// ══════════════════════════════════════════════════════════════════════════════
// DATA QUALITY CHECK
// ══════════════════════════════════════════════════════════════════════════════

// Detect low quality bars (extended hours or low volume)
isExtendedHours = not inRTH
isLowVolume = volume < ta.sma(volume, 20) * 0.3
isNarrowRange = (high - low) < ta.atr(14) * 0.2
lowQualityBar = isExtendedHours or (isLowVolume and isNarrowRange)

// Reduce confidence in signals during low quality periods
signalQualityMultiplier = lowQualityBar ? 0.5 : 1.0

// ══════════════════════════════════════════════════════════════════════════════
// CALCULATIONS (Original Algorithm)
// ══════════════════════════════════════════════════════════════════════════════

vol = volume > 0 ? volume : 1

// Bull And Bear "Power-Balance" by Vadim Gimelfarb Algorithm's
BP = close < open ? (close[1] < open ? math.max(high - close[1], close - low) : math.max(high - open, close - low)) : close > open ? (close[1] > open ? high - low : math.max(open - close[1], high - low)) : high - close > close - low ? (close[1] < open ? math.max(high - close[1], close - low) : high - open) : high - close < close - low ? (close[1] > open ? high - low : math.max(open - close[1], high - low)) : (close[1] > open ? math.max(high - open, close - low) : close[1] < open ? math.max(open - close[1], high - low) : high - low)

SP = close < open ? (close[1] > open ? math.max(close[1] - open, high - low) : high - low) : close > open ? (close[1] > open ? math.max(close[1] - low, high - close) : math.max(open - low, high - close)) : high - close > close - low ? (close[1] > open ? math.max(close[1] - open, high - low) : high - low) : high - close < close - low ? (close[1] > open ? math.max(close[1] - low, high - close) : open - low) : (close[1] > open ? math.max(close[1] - open, high - low) : close[1] < open ? math.max(open - low, high - close) : high - low)

TP = BP + SP

// RAW Pressure Volume Calculations
BPV = (BP/TP) * vol
SPV = (SP/TP) * vol
TPV = BPV + SPV
BPVavg = ta.ema(ta.ema(BPV, fastMAPeriod), fastMAPeriod)
SPVavg = ta.ema(ta.ema(SPV, fastMAPeriod), fastMAPeriod)
TPVavg = ta.ema(ta.wma(TPV, fastMAPeriod), fastMAPeriod)

// Karthik Marar's Pressure Volume Normalized Version
VN = vol / ta.ema(vol, longPeriod)
BPN = ((BP / ta.ema(BP, longPeriod)) * VN) * 100
SPN = ((SP / ta.ema(SP, longPeriod)) * VN) * 100
TPN = BPN + SPN
nbf = ta.ema(ta.wma(BPN, fastMAPeriod), fastMAPeriod)
nsf = ta.ema(ta.wma(SPN, fastMAPeriod), fastMAPeriod)
tpf = ta.ema(ta.wma(TPN, fastMAPeriod), fastMAPeriod)

// Conditional Selectors for RAW/Norm
BPc1 = BPV > SPV ? BPV : -math.abs(BPV)
BPc2 = BPN > SPN ? BPN : -math.abs(BPN)
SPc1 = SPV > BPV ? SPV : -math.abs(SPV)
SPc2 = SPN > BPN ? SPN : -math.abs(SPN)
BPcon = norm ? BPc2 : BPc1
SPcon = norm ? SPc2 : SPc1
BPAcon = norm ? nbf : BPVavg
SPAcon = norm ? nsf : SPVavg
TPAcon = norm ? tpf : TPVavg

// Volume Pressure Convergence Divergence
vpo1 = vinv ? ((math.sum(BPVavg, longPeriod) - math.sum(SPVavg, longPeriod)) / math.sum(TPVavg, longPeriod)) * 100 : ((BPVavg - SPVavg) / TPVavg) * 100
vpo2 = vinv ? ((math.sum(nbf, longPeriod) - math.sum(nsf, longPeriod)) / math.sum(tpf, longPeriod)) * 100 : ((nbf - nsf) / tpf) * 100
vph = nz((vpo1 - vpo2), 0)


// ══════════════════════════════════════════════════════════════════════════════
// DIVERGENCE DETECTION
// ══════════════════════════════════════════════════════════════════════════════

// Price peaks and troughs
priceHigh = ta.highest(high, divergenceLookback)
priceLow = ta.lowest(low, divergenceLookback)
priceAtHigh = high == priceHigh
priceAtLow = low == priceLow

// Volume pressure peaks and troughs
bullPressureHigh = ta.highest(BPAcon, divergenceLookback)
sellPressureHigh = ta.highest(SPAcon, divergenceLookback)

// Bearish Divergence: Price making higher high but bull pressure declining
bearishDiv = priceAtHigh and BPAcon < BPAcon[1] and BPAcon < BPAcon[2] and vpo1 > 0
bearishDivConfirmed = bearishDiv and vph < vph[1]

// Bullish Divergence: Price making lower low but sell pressure declining  
bullishDiv = priceAtLow and SPAcon < SPAcon[1] and SPAcon < SPAcon[2] and vpo1 < 0
bullishDivConfirmed = bullishDiv and vph > vph[1]

// Hidden Divergence (continuation patterns)
hiddenBullDiv = priceAtHigh and vpo1 > vpo1[divergenceLookback/2] and vpo1 > 0
hiddenBearDiv = priceAtLow and vpo1 < vpo1[divergenceLookback/2] and vpo1 < 0

// ══════════════════════════════════════════════════════════════════════════════
// MOMENTUM ACCELERATION
// ══════════════════════════════════════════════════════════════════════════════

// Rate of change in volume pressure
bullAccel = ta.roc(BPAcon, 3)
sellAccel = ta.roc(SPAcon, 3)
vpo1Accel = ta.roc(vpo1, 3)

// Exhaustion signals (high pressure but decelerating)
bullExhaustion = BPAcon > ta.sma(BPAcon, 20) and bullAccel < -15 and vpo1 > 0
sellExhaustion = SPAcon > ta.sma(SPAcon, 20) and sellAccel < -15 and vpo1 < 0

// Early acceleration signals (building momentum)
bullAccelerating = BPAcon > SPAcon and bullAccel > 20 and vpo1Accel > 0
sellAccelerating = SPAcon > BPAcon and sellAccel > 20 and vpo1Accel < 0

// Momentum shift detection
momentumShift = (vph > 0 and vph[1] <= 0) or (vph < 0 and vph[1] >= 0)


// ══════════════════════════════════════════════════════════════════════════════
// TREND STRENGTH SCORE (0-100)
// ══════════════════════════════════════════════════════════════════════════════

var float trendStrength = 0.0

// Factor 1: Volume pressure dominance (40 points)
vpDominance = math.abs((BPAcon - SPAcon) / (BPAcon + SPAcon)) * 100
vpScore = vpDominance > 70 ? 40 : vpDominance > 50 ? 30 : vpDominance > 30 ? 20 : 10

// Factor 2: Convergence strength (30 points)
vpo1Strength = math.abs(vpo1)
convScore = vpo1Strength > 30 ? 30 : vpo1Strength > 15 ? 20 : vpo1Strength > 5 ? 10 : 5

// Factor 3: Histogram momentum (30 points)
vphStrength = math.abs(vph)
histScore = vphStrength > 10 ? 30 : vphStrength > 5 ? 20 : vphStrength > 2 ? 10 : 5

trendStrength := vpScore + convScore + histScore

// Trend quality assessment
trendQuality = trendStrength > 75 ? "STRONG" : trendStrength > 50 ? "MODERATE" : trendStrength > 30 ? "WEAK" : "CHOPPY"

