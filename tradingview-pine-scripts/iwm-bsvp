// BUY/SELL SIGNAL LABELS (in indicator pane)
// ══════════════════════════════════════════════════════════════════════════════

if showSignalLabels and (alwaysOn or inRTH)
    // Find the highest and lowest values across all visible bars for proper scaling
    var float maxRange = na
    var float minRange = na
    
    currentHigh = vmacd ? math.max(vpo1, vpo2, vph, 0) : math.max(BPcon, SPcon, BPAcon, SPAcon, 0)
    currentLow = vmacd ? math.min(vpo1, vpo2, vph, 0) : math.min(BPcon, SPcon, BPAcon, SPAcon, 0)
    
    // Track max/min for better positioning
    maxRange := na(maxRange) ? currentHigh : math.max(maxRange, currentHigh)
    minRange := na(minRange) ? currentLow : math.min(minRange, currentLow)
    
    // Calculate label positions - MIRRORED for readability
    paneRange = maxRange - minRange
    buyLabelPosition = maxRange + (paneRange * 0.25)    // Buy labels above the lines
    sellLabelPosition = minRange - (paneRange * 0.25)   // Sell labels below the lines
    
    // Buy Signal Label - CREATE NEW LABEL ON EVERY SIGNAL CHANGE
    if buySignal and not buySignal[1]
        label.new(bar_index, buyLabelPosition, "Buy", 
                 style=label.style_label_down, 
                 color=color.new(bullColor, 0), 
                 textcolor=color.white, 
                 size=size.small,
                 tooltip=signalTooltip)
    
    // Sell Signal Label - CREATE NEW LABEL ON EVERY SIGNAL CHANGE
    if sellSignal and not sellSignal[1]
        label.new(bar_index, sellLabelPosition, "Sell", 
                 style=label.style_label_up, 
                 color=color.new(bearColor, 0), 
                 textcolor=color.white, 
                 size=size.small,
                 tooltip=signalTooltip)


