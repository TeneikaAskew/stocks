// Delete any existing lightbulb labels before creating new one
var label lightbulbLabel = na

// Signal Summary at bottom of chart (visible lightbulb icon - current bar only)
if showSignalIcon and barstate.islast and (alwaysOn or inRTH)
    // Delete previous label if it exists
    label.delete(lightbulbLabel)
    
    // Calculate bottom position based on current indicator range
    highestValue = vmacd ? math.max(vpo1, vpo2, vph, 0) : math.max(BPcon, SPcon, 0)
    lowestValue = vmacd ? math.min(vpo1, vpo2, vph, 0) : math.min(BPcon, SPcon, 0)
    
    // Calculate the range and place icon below the lowest point
    rangeVal = highestValue - lowestValue
    iconPosition = lowestValue - (rangeVal * 0.15) // Place 15% of range below the lowest value
    
    // Determine icon color based on signal
    iconColor = buySignal ? color.new(bullColor, 20) : sellSignal ? color.new(bearColor, 20) : color.new(neutralColor, 20)
    
    lightbulbLabel := label.new(bar_index, iconPosition, "💡", style=label.style_label_up, color=iconColor, textcolor=color.yellow, size=size.small, tooltip=signalTooltip)

// Historical tooltips - invisible labels on signal bars only
if showSignalIcon and (alwaysOn or inRTH)
    if buySignal or sellSignal
        // Create invisible label with tooltip on signal bars
        label.new(bar_index, vpo1, "", 
                 style=label.style_circle, 
                 size=size.tiny, 
                 color=color.new(color.white, 100), 
