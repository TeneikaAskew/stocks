// buySignal = BPcon > 0 and vpo1 > 0 and vpo1 > vpo2
// sellSignal = SPcon > 0 and vpo1 < 0 and vpo1 < vpo2

// // Enhanced buy/sell signals with quality check
// buySignal = BPcon > 0 and vpo1 > 0 and vpo1 > vpo2 and not bearishDivConfirmed
// sellSignal = SPcon > 0 and vpo1 < 0 and vpo1 < vpo2 and not bullishDivConfirmed

// Enhanced extended hours check for buy/sell signals with quality check
