sellSignal = (alwaysOn or inRTH) and SPcon > 0 and vpo1 < 0 and vpo1 < vpo2 and not bullishDivConfirmed and not lowQualityBar


// Alert signal calculations
// strongBuy = BPcon > 0 and BPcon > BPcon[1] and vpo1 > 0 and vpo1 > vpo2 and vph > 0
// strongSell = SPcon > 0 and SPcon > SPcon[1] and vpo1 < 0 and vpo1 < vpo2 and vph < 0

// Update existing strongBuy/strongSell to incorporate new factors
// strongBuy = BPcon > 0 and BPcon > BPcon[1] and vpo1 > 0 and vpo1 > vpo2 and vph > 0 and not bearishDiv
// strongSell = SPcon > 0 and SPcon > SPcon[1] and vpo1 < 0 and vpo1 < vpo2 and vph < 0 and not bullishDiv

// Enhanced extended hours check for strongBuy/strongSell to incorporate RTH filter
strongBuy = (alwaysOn or inRTH) and BPcon > 0 and BPcon > BPcon[1] and vpo1 > 0 and vpo1 > vpo2 and vph > 0 and not bearishDiv
strongSell = (alwaysOn or inRTH) and SPcon > 0 and SPcon > SPcon[1] and vpo1 < 0 and vpo1 < vpo2 and vph < 0 and not bullishDiv


bullCross = ta.crossover(vpo1, vpo2) and vpo1 > 0
bearCross = ta.crossunder(vpo1, vpo2) and vpo1 < 0

tradeSignal = buySignal ? "BUY" : sellSignal ? "SELL" : "WAIT"


// ══════════════════════════════════════════════════════════════════════════════
// ENTRY QUALITY SCORE (0-100)
// ══════════════════════════════════════════════════════════════════════════════

var float entryQuality = 0.0

// Factor 1: Trend strength (30 points)
trendScore = trendStrength > 75 ? 30 : trendStrength > 50 ? 20 : trendStrength > 30 ? 10 : 0

// Factor 2: Momentum acceleration (25 points)
accelScore = (bullAccelerating or sellAccelerating) ? 25 : momentumShift ? 15 : 0

// Factor 3: No divergence warning (20 points)
divScore = not bearishDiv and not bullishDiv ? 20 : 10

// Factor 4: Volume pressure alignment (25 points)
alignScore = (BPcon > 0 and vpo1 > 0 and vpo1 > vpo2) or (SPcon > 0 and vpo1 < 0 and vpo1 < vpo2) ? 25 : 10

// entryQuality := trendScore + accelScore + divScore + alignScore

entryQuality := (trendScore + accelScore + divScore + alignScore) * signalQualityMultiplier

// Add quality warning
dataQuality = lowQualityBar ? "LOW (Extended Hours)" : "HIGH (RTH)"


// Entry timing assessment
entryTiming = entryQuality > 70 ? "PRIME" : entryQuality > 50 ? "GOOD" : entryQuality > 30 ? "WAIT" : "AVOID"

// Late entry warning
lateEntry = (buySignal or sellSignal) and trendStrength > 70 and not (bullAccelerating or sellAccelerating)
earlyEntry = (buySignal or sellSignal) and (bullAccelerating or sellAccelerating) and entryQuality > 70

// Prime entry signals (high quality setups)
// primeBuy = buySignal and earlyEntry and not bullExhaustion
// primeSell = sellSignal and earlyEntry and not sellExhaustion

// Enhanced extended hours check forPrime entry signals (high quality setups)
primeBuy = buySignal and earlyEntry and not bullExhaustion and inRTH
primeSell = sellSignal and earlyEntry and not sellExhaustion and inRTH


// Add these after the Entry Quality Score section:
plot(trendStrength, "Trend Strength", color=color.new(color.yellow, 0), display=display.status_line)
plot(entryQuality, "Entry Quality", color=color.new(color.aqua, 0), display=display.status_line)

// ══════════════════════════════════════════════════════════════════════════════
// TOOLTIP GENERATION
// ══════════════════════════════════════════════════════════════════════════════

signalTooltip = ""
if tooltipDetail == "Simple"
    signalTooltip := "Volume Pressure: " + (BPcon > 0 ? "Bullish" : "Bearish") + "\n" + "Convergence: " + (vpo1 > 0 ? "Bullish" : "Bearish") + " (" + str.tostring(vpo1, "#.#") + "%)"
else if tooltipDetail == "Detailed"
    // Determine current trading action
    currentSignal = buySignal ? "🟢 STRONG CALL BUY" : sellSignal ? "🔴 STRONG PUT BUY" : (BPcon > 0 and vpo1 > 0) ? "🟡 WEAK CALL BIAS" : (SPcon > 0 and vpo1 < 0) ? "🟡 WEAK PUT BIAS" : "⚪ WAIT/FLAT"
    
    // Check alerts - NEW SECTION!
    alertText = ""
    if strongBuy
        alertText := alertText + "✅ STRONG BUY ALERT\n"
    if strongSell  
        alertText := alertText + "✅ STRONG SELL ALERT\n"
    if bullCross
        alertText := alertText + "📈 BULL CONVERGENCE CROSS\n"
    if bearCross
        alertText := alertText + "📉 BEAR CONVERGENCE CROSS\n"
    
    // Add detailed breakdown of why alerts may not be active
    breakdown = ""
    
    // Show what's needed for strong buy when in any bullish situation
    if (BPcon > 0 and vpo1 > 0) and not strongBuy
        breakdown := breakdown + "🔍 STRONG BUY needs:\n"
        breakdown := breakdown + (BPcon > BPcon[1] ? "✅" : "❌") + " Buying pressure increasing\n"
        breakdown := breakdown + (vpo1 > vpo2 ? "✅" : "❌") + " Convergence above signal line\n"
        breakdown := breakdown + (vph > 0 ? "✅" : "❌") + " Histogram positive\n"
    
    // Show what's needed for strong sell when in any bearish situation  
    if (SPcon > 0 and vpo1 < 0) and not strongSell
        breakdown := breakdown + "🔍 STRONG SELL needs:\n"
        breakdown := breakdown + (SPcon > SPcon[1] ? "✅" : "❌") + " Selling pressure increasing\n"
        breakdown := breakdown + (vpo1 < vpo2 ? "✅" : "❌") + " Convergence below signal line\n"
        breakdown := breakdown + (vph < 0 ? "✅" : "❌") + " Histogram negative\n"
    
    if alertText == ""
        alertText := "⏸️ No alerts currently active" + (breakdown != "" ? "\n" + breakdown : "")
    else
        alertText := alertText + (breakdown != "" ? breakdown : "")
    
    signalTooltip := "═══ TRADING ACTION ═══\n" + currentSignal + "\n─────────────────\nVolume Pressure: " + (BPcon > 0 ? "Bullish" : "Bearish") + "\nConvergence: " + (vpo1 > 0 ? "Bullish" : "Bearish") + " (" + str.tostring(vpo1, "#.#") + "%)\nSignal Line: " + str.tostring(vpo2, "#.#") + "%\nHistogram: " + str.tostring(vph, "#.#") + "\n─────────────────\n" + (buySignal ? "🎯 ENTRY: Buy calls now\n💰 EXIT: When convergence peaks" : sellSignal ? "🎯 ENTRY: Buy puts now\n💰 EXIT: When convergence bottoms" : (vpo1 > vpo2 and vph > 0) ? "⏳ WAIT: Call setup building\n📈 WATCH: For volume confirmation" : (vpo1 < vpo2 and vph < 0) ? "⏳ WAIT: Put setup building\n📉 WATCH: For volume confirmation" : "😴 FLAT: No clear direction\n🔄 WAIT: For better setup") + "\n─────────────────\n🔔 CONFLUENCE ALERTS:\n" + alertText
else
    signalTooltip := "═══ FULL ANALYSIS ═══\n" + "Buy Pressure: " + str.tostring(math.round(BPV)) + " (" + str.tostring(ratio) + "%)\n" + "Sell Pressure: " + str.tostring(math.round(SPV)) + " (" + str.tostring(100-ratio) + "%)\n" + "Convergence (VPO1): " + str.tostring(vpo1, "#.##") + "%\n" + "Signal Line (VPO2): " + str.tostring(vpo2, "#.##") + "%\n" + "Histogram: " + str.tostring(vph, "#.##") + "\n" + "─────────────────\n" + "Mode: " + (norm ? "Filtered (normalized data)" : "Raw (direct volume data)") + "\n" + "─────────────────\n" + "Entry Conditions:\n" + "• Volume confirms direction\n" + "• Convergence aligns\n" + "• Histogram momentum positive"

