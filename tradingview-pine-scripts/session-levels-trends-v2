// Compute RSI and StochRSI for confirmation signals
rsiVal = ta.rsi(close, 14)
stochK = ta.stoch(rsiVal, rsiVal, rsiVal, 14)

// Persistent labels for confirmation signals (delete previous to avoid overflow)
var label lblConfirmSupport = na
var label lblConfirmResist = na

// Check proximity to key levels and generate confirmation signals
if showConfirmation
    float proxPct = confirmProximity / 100.0

    // Build arrays of support and resistance levels
    bool nearSupport = false
    string supportName = ""
    float supportLevel = na

    bool nearResist = false
    string resistName = ""
    float resistLevel = na

    // Check support levels: PDL, PWL, PMOL
    if not na(pdl) and math.abs(close - pdl) / pdl <= proxPct
        nearSupport := true
        supportName := "PDL"
        supportLevel := pdl
    if not na(pwl) and math.abs(close - pwl) / pwl <= proxPct
        nearSupport := true
        supportName := "PWL"
        supportLevel := pwl
    if not na(pmol) and math.abs(close - pmol) / pmol <= proxPct
        nearSupport := true
        supportName := "PMOL"
        supportLevel := pmol

    // Check resistance levels: PDH, PWH, PMOH
    if not na(pdh) and math.abs(close - pdh) / pdh <= proxPct
        nearResist := true
        resistName := "PDH"
        resistLevel := pdh
    if not na(pwh) and math.abs(close - pwh) / pwh <= proxPct
        nearResist := true
        resistName := "PWH"
        resistLevel := pwh
    if not na(pmoh) and math.abs(close - pmoh) / pmoh <= proxPct
        nearResist := true
        resistName := "PMOH"
        resistLevel := pmoh

    // Oversold at Support: RSI < 30 and StochK < 20
    if nearSupport and rsiVal < 30 and stochK < 20
        lblConfirmSupport := deleteLabel(lblConfirmSupport)
        lblConfirmSupport := label.new(bar_index, low, "Oversold\nat " + supportName,
             style=label.style_circle, color=color.green,
             textcolor=color.white, size=size.tiny, yloc=yloc.belowbar,
             tooltip="RSI: " + str.tostring(rsiVal, "#.#") + " | StochRSI: " + str.tostring(stochK, "#.#") +
                     "\nLevel: " + supportName + " (" + str.tostring(supportLevel, "#.##") + ")" +
                     "\nBacktest: +15-20pp WR lift at oversold support")

    // Overbought at Resistance: RSI > 70 and StochK > 80
    if nearResist and rsiVal > 70 and stochK > 80
        lblConfirmResist := deleteLabel(lblConfirmResist)
        lblConfirmResist := label.new(bar_index, high, "Overbought\nat " + resistName,
             style=label.style_circle, color=color.red,
             textcolor=color.white, size=size.tiny, yloc=yloc.abovebar,
             tooltip="RSI: " + str.tostring(rsiVal, "#.#") + " | StochRSI: " + str.tostring(stochK, "#.#") +
                     "\nLevel: " + resistName + " (" + str.tostring(resistLevel, "#.##") + ")" +
                     "\nBacktest: +15-20pp WR lift at overbought resistance")

