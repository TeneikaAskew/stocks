// ORB Failure Detection persistent variables (v2)
var int barsSinceBreakUp = 0
var int barsSinceBreakDn = 0
var bool orbFailUp = false
var bool orbFailDn = false
var bool orbBreakUpTriggered = false
var bool orbBreakDnTriggered = false

// Calculate minutes since regular session open (for time period mode)
var int regularOpenTime = na
if firstBarRegular
    regularOpenTime := time

int minutesSinceOpen = na
if not na(regularOpenTime) and isRegular
    minutesSinceOpen := int((time - regularOpenTime) / 60000)

// Reset ORB on new day
if newDay
    orbHigh := na
    orbLow := na
    orbStartBar := na
    orbEndBar := na
    orbComplete := false
    orbBrokenUp := false
    orbBrokenDown := false
    regularOpenTime := na
    // Reset ORB failure tracking (v2)
    barsSinceBreakUp := 0
    barsSinceBreakDn := 0
    orbFailUp := false
    orbFailDn := false
    orbBreakUpTriggered := false
    orbBreakDnTriggered := false
    if not na(lORBH)
        line.delete(lORBH)
        lORBH := na
    if not na(lORBL)
        line.delete(lORBL)
        lORBL := na
    if not na(orbBox)
        box.delete(orbBox)
        orbBox := na

// Track ORB - FIRST BAR ONLY MODE
if showORB and orbType == "First Bar Only" and firstBarRegular
    orbHigh := high
    orbLow := low
    orbStartBar := bar_index
    orbEndBar := bar_index
    orbComplete := true

// Track ORB - TIME PERIOD MODE
if showORB and orbType == "Time Period" and isRegular and not na(minutesSinceOpen)
    if minutesSinceOpen <= orbMinutes
        if na(orbStartBar)
            orbStartBar := bar_index

        orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
        orbLow := na(orbLow) ? low : math.min(orbLow, low)
        orbEndBar := bar_index
    else if not orbComplete and not na(orbHigh) and not na(orbLow)
        orbComplete := true

// Draw ORB lines and box - only create once
if showORB and orbComplete and not na(orbHigh) and not na(orbLow)
    // Draw ORB High line (create once) - extend both directions to cover entire chart
    if na(lORBH)
        lORBH := line.new(orbEndBar, orbHigh, orbEndBar + 1, orbHigh,
                         extend=extend.both, color=colORB, width=2, style=line.style_solid)

    // Update color based on breakout status
    if not na(lORBH)
        line.set_color(lORBH, orbBrokenUp ? colORBUp : colORB)

    // Draw ORB Low line (create once) - extend both directions to cover entire chart
    if na(lORBL)
        lORBL := line.new(orbEndBar, orbLow, orbEndBar + 1, orbLow,
                         extend=extend.both, color=colORB_f, width=2, style=line.style_solid)

    // Update color based on breakdown status
    if not na(lORBL)
        line.set_color(lORBL, orbBrokenDown ? colORBDown : colORB_f)

    // Draw ORB box (shaded area)
    if na(orbBox)
        orbBox := box.new(left=orbStartBar, right=orbEndBar,
                         top=orbHigh, bottom=orbLow,
                         bgcolor=colORBBox, border_color=colORB, border_width=1)

    // Add labels on last bar - FIXED
    if barstate.islast
        label.delete(lblORBHigh)
        label.delete(lblORBLow)
        lblORBHigh := label.new(bar_index + 10, orbHigh, "ORB High",
                 style=label.style_label_left, color=colORB,
                 textcolor=color.black, size=size.tiny)
        lblORBLow := label.new(bar_index + 10, orbLow, "ORB Low",
                 style=label.style_label_left, color=colORB_f,
                 textcolor=color.black, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════
// ADAPTIVE SUPERTREND CALCULATIONS (v2)
// (Computed before ORB breakout detection so 'trend' is available for quality score)
// ═══════════════════════════════════════════════════════════════════

atr2 = ta.sma(ta.tr, Periods)
atrVal = changeATR ? ta.atr(Periods) : atr2

// Adaptive volatility regime (v2)
atrSma50 = ta.sma(ta.atr(14), 50)
highVol = ta.atr(14) > atrSma50 * 1.5
lowVol  = ta.atr(14) < atrSma50 * 0.7
volMultiplier = highVol ? 1.3 : lowVol ? 0.7 : 1.0

// Apply adaptive multiplier if enabled, otherwise use standard
effectiveMultiplier = useAdaptiveST ? Multiplier * volMultiplier : Multiplier

up = stSrc - (effectiveMultiplier * atrVal)
up1 = nz(up[1], up)
up := close[1] > up1 ? math.max(up, up1) : up

dn = stSrc + (effectiveMultiplier * atrVal)
dn1 = nz(dn[1], dn)
dn := close[1] < dn1 ? math.min(dn, dn1) : dn

var int trend = 1
trend := nz(trend[1], trend)
trend := trend == -1 and close > dn1 ? 1 : trend == 1 and close < up1 ? -1 : trend

// ═══════════════════════════════════════════════════════════════════
// ORB BREAKOUT DETECTION WITH QUALITY SCORE (v2)
// ═══════════════════════════════════════════════════════════════════

// Pre-compute ATR and RVOL for ORB quality score (needed before breakout detection)
atrForQuality = ta.atr(14)
rvolVal = nz(volume / ta.sma(volume, 50), 0)

// Detect ORB breakouts (with quality score integration)
if showORB and showORBBreaks and orbComplete and not na(orbHigh) and not na(orbLow)
    // Breakout above ORB High
    if not orbBrokenUp and close > orbHigh
        orbBrokenUp := true
        orbBreakUpTriggered := true
        barsSinceBreakUp := 0

        // ORB Quality Score computation (v2)
        float orbRange = orbHigh - orbLow
        int orbQualityATR = orbRange < atrForQuality ? 1 : 0
        int orbQualityST = trend == 1 ? 1 : 0
        int orbQualityRSI = rsiVal > 50 ? 1 : 0
        int orbQualityVol = rvolVal > 1.0 ? 1 : 0
        int orbQuality = orbQualityATR + orbQualityST + orbQualityRSI + orbQualityVol

        string qLabel = "ORB up"
        string qTooltip = "ORB Breakout Up - Quality: " + str.tostring(orbQuality) + "/4"
             + "\nATR tight: " + (orbQualityATR == 1 ? "YES" : "NO") + " (range " + str.tostring(orbRange, "#.##") + " vs ATR " + str.tostring(atrForQuality, "#.##") + ")"
             + "\nSupertrend align: " + (orbQualityST == 1 ? "YES" : "NO")
             + "\nRSI momentum: " + (orbQualityRSI == 1 ? "YES" : "NO") + " (RSI " + str.tostring(rsiVal, "#.#") + ")"
             + "\nVolume confirm: " + (orbQualityVol == 1 ? "YES" : "NO") + " (RVOL " + str.tostring(rvolVal, "#.##") + ")"

        if showORBQuality
            qLabel := "ORB up Q:" + str.tostring(orbQuality) + "/4"

        label.new(bar_index, low, qLabel,
                 style=label.style_label_up, color=colORBUp,
                 textcolor=color.black, size=size.small, yloc=yloc.belowbar,
                 tooltip=qTooltip)

    // Breakdown below ORB Low
    if not orbBrokenDown and close < orbLow
        orbBrokenDown := true
        orbBreakDnTriggered := true
        barsSinceBreakDn := 0

        // ORB Quality Score computation (v2)
        float orbRange = orbHigh - orbLow
        int orbQualityATR = orbRange < atrForQuality ? 1 : 0
        int orbQualityST = trend == -1 ? 1 : 0
        int orbQualityRSI = rsiVal < 50 ? 1 : 0
        int orbQualityVol = rvolVal > 1.0 ? 1 : 0
        int orbQuality = orbQualityATR + orbQualityST + orbQualityRSI + orbQualityVol

        string qLabel = "ORB dn"
        string qTooltip = "ORB Breakdown - Quality: " + str.tostring(orbQuality) + "/4"
             + "\nATR tight: " + (orbQualityATR == 1 ? "YES" : "NO") + " (range " + str.tostring(orbRange, "#.##") + " vs ATR " + str.tostring(atrForQuality, "#.##") + ")"
             + "\nSupertrend align: " + (orbQualityST == 1 ? "YES" : "NO")
             + "\nRSI momentum: " + (orbQualityRSI == 1 ? "YES" : "NO") + " (RSI " + str.tostring(rsiVal, "#.#") + ")"
             + "\nVolume confirm: " + (orbQualityVol == 1 ? "YES" : "NO") + " (RVOL " + str.tostring(rvolVal, "#.##") + ")"

        if showORBQuality
            qLabel := "ORB dn Q:" + str.tostring(orbQuality) + "/4"

        label.new(bar_index, high, qLabel,
                 style=label.style_label_down, color=colORBDown,
                 textcolor=color.black, size=size.small, yloc=yloc.abovebar,
                 tooltip=qTooltip)

// ═══════════════════════════════════════════════════════════════════
// ORB FAILURE DETECTION (v2)
// ═══════════════════════════════════════════════════════════════════

// Track bars since breakout and detect failures
if showORBFailure and orbComplete and not na(orbHigh) and not na(orbLow)
    // Track bars since upward breakout
    if orbBreakUpTriggered and not orbFailUp
        barsSinceBreakUp += 1
        // If price returns below orbHigh within N bars, it's a failure
        if barsSinceBreakUp <= orbFailBars and close < orbHigh
            orbFailUp := true
            label.new(bar_index, high, "ORB FAIL",
                 style=label.style_label_down, color=color.new(color.red, 0),
                 textcolor=color.white, size=size.small, yloc=yloc.abovebar,
                 tooltip="ORB Breakout Up FAILED\nPrice returned below ORB High within " + str.tostring(barsSinceBreakUp) + " bars\nORB High: " + str.tostring(orbHigh, "#.##"))

    // Track bars since downward breakdown
    if orbBreakDnTriggered and not orbFailDn
        barsSinceBreakDn += 1
        // If price returns above orbLow within N bars, it's a failure
        if barsSinceBreakDn <= orbFailBars and close > orbLow
            orbFailDn := true
            label.new(bar_index, low, "ORB FAIL",
                 style=label.style_label_up, color=color.new(color.red, 0),
                 textcolor=color.white, size=size.small, yloc=yloc.belowbar,
                 tooltip="ORB Breakdown FAILED\nPrice returned above ORB Low within " + str.tostring(barsSinceBreakDn) + " bars\nORB Low: " + str.tostring(orbLow, "#.##"))

// ═══════════════════════════════════════════════════════════════════
// VOLATILITY REGIME LABEL (v2)
// ═══════════════════════════════════════════════════════════════════

var label lblVolRegime = na
if showVolRegime and useAdaptiveST and barstate.islast
    lblVolRegime := deleteLabel(lblVolRegime)
    string volText = highVol ? "HV" : lowVol ? "LV" : "NV"
    color volColor = highVol ? color.new(color.red, 20) : lowVol ? color.new(color.green, 20) : color.new(color.gray, 20)
    string volTooltip = "Volatility Regime: " + (highVol ? "HIGH" : lowVol ? "LOW" : "NORMAL")
         + "\nATR(14): " + str.tostring(ta.atr(14), "#.##")
         + "\nATR SMA(50): " + str.tostring(atrSma50, "#.##")
         + "\nMultiplier adjusted: " + str.tostring(effectiveMultiplier, "#.##")
         + " (base " + str.tostring(Multiplier, "#.#") + " x " + str.tostring(volMultiplier, "#.##") + ")"
    lblVolRegime := label.new(bar_index + 2, high, volText,
         style=label.style_label_down, color=volColor,
         textcolor=color.white, size=size.small,
         tooltip=volTooltip)

// ═══════════════════════════════════════════════════════════════════
// SUPERTREND PLOTTING
// ═══════════════════════════════════════════════════════════════════

upPlot = plot(trend == 1 ? up : na, title="Up Trend", style=plot.style_linebr, linewidth=2, color=colSTUp)

buySignal = trend == 1 and trend[1] == -1
plotshape(buySignal ? up : na, title="UpTrend Begins", location=location.absolute, style=shape.circle, size=size.tiny, color=colSTUp)
plotshape(buySignal and showsignals ? up : na, title="Buy", text="Buy", location=location.absolute, style=shape.labelup, size=size.tiny, color=colSTUp, textcolor=color.white)

dnPlot = plot(trend == 1 ? na : dn, title="Down Trend", style=plot.style_linebr, linewidth=2, color=colSTDown)

sellSignal = trend == -1 and trend[1] == 1
plotshape(sellSignal ? dn : na, title="DownTrend Begins", location=location.absolute, style=shape.circle, size=size.tiny, color=colSTDown)
plotshape(sellSignal and showsignals ? dn : na, title="Sell", text="Sell", location=location.absolute, style=shape.labeldown, size=size.tiny, color=colSTDown, textcolor=color.white)

mPlot = plot(ohlc4, title="", style=plot.style_circles, linewidth=1, display=display.none)

longFillColor = highlighting ? (trend == 1 ? colSTUpFill : color.new(color.white, 100)) : color.new(color.white, 100)
shortFillColor = highlighting ? (trend == -1 ? colSTDownFill : color.new(color.white, 100)) : color.new(color.white, 100)

fill(mPlot, upPlot, title="UpTrend Highlighter", color=longFillColor)
fill(mPlot, dnPlot, title="DownTrend Highlighter", color=shortFillColor)

// ═══════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════

alertcondition(buySignal, title="SuperTrend Buy", message="SuperTrend Buy!")
alertcondition(sellSignal, title="SuperTrend Sell", message="SuperTrend Sell!")
changeCond = trend != trend[1]
alertcondition(changeCond, title="SuperTrend Direction Change", message="SuperTrend has changed direction!")


// ═══════════════════════════════════════════════════════════════════
// ORB ALERTS
// ═══════════════════════════════════════════════════════════════════
orbBreakoutUp = showORB and orbComplete and not orbBrokenUp[1] and orbBrokenUp
orbBreakoutDown = showORB and orbComplete and not orbBrokenDown[1] and orbBrokenDown

alertcondition(orbBreakoutUp, title="ORB Breakout Up", message="Price broke above Opening Range High!")
alertcondition(orbBreakoutDown, title="ORB Breakdown", message="Price broke below Opening Range Low!")

// ═══════════════════════════════════════════════════════════════════
// ORB FAILURE ALERTS (v2)
// ═══════════════════════════════════════════════════════════════════
orbFailUpAlert = showORBFailure and orbFailUp and not orbFailUp[1]
orbFailDnAlert = showORBFailure and orbFailDn and not orbFailDn[1]

alertcondition(orbFailUpAlert, title="ORB Failure Up", message="ORB Breakout Up FAILED - price returned below ORB High!")
alertcondition(orbFailDnAlert, title="ORB Failure Down", message="ORB Breakdown FAILED - price returned above ORB Low!")

// ═══════════════════════════════════════════════════════════════════
// INDICATOR CONFIRMATION ALERTS (v2)
// ═══════════════════════════════════════════════════════════════════
oversoldAtSupport = showConfirmation and rsiVal < 30 and stochK < 20 and
     ((not na(pdl) and math.abs(close - pdl) / pdl <= confirmProximity / 100.0) or
      (not na(pwl) and math.abs(close - pwl) / pwl <= confirmProximity / 100.0) or
      (not na(pmol) and math.abs(close - pmol) / pmol <= confirmProximity / 100.0))

overboughtAtResist = showConfirmation and rsiVal > 70 and stochK > 80 and
     ((not na(pdh) and math.abs(close - pdh) / pdh <= confirmProximity / 100.0) or
      (not na(pwh) and math.abs(close - pwh) / pwh <= confirmProximity / 100.0) or
      (not na(pmoh) and math.abs(close - pmoh) / pmoh <= confirmProximity / 100.0))

alertcondition(oversoldAtSupport, title="Oversold at Support Level", message="Price oversold (RSI<30, StochRSI<20) near key support level!")
alertcondition(overboughtAtResist, title="Overbought at Resistance Level", message="Price overbought (RSI>70, StochRSI>80) near key resistance level!")

