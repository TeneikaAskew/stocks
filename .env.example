# ============================================================
# Stocks/Trading Application - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to git (it's in .gitignore)
# ============================================================

# ------------------------------------------------------------
# FRED API (Federal Reserve Economic Data)
# ------------------------------------------------------------
# Get your API key from: https://fred.stlouisfed.org/docs/api/api_key.html
# Used by: scripts/market_events_tracker.py, scripts/fetch_economic_calendar.py
# Purpose: Fetch economic indicators (CPI, unemployment, GDP, etc.)
FRED_API_KEY=your_fred_api_key_here

# ------------------------------------------------------------
# Google Sheets API (Optional)
# ------------------------------------------------------------
# Used by: scripts/download_google_sheets.py
# Purpose: Download data from Google Sheets to local storage
# Get credentials from: https://console.cloud.google.com/apis/credentials

# Path to your Google Sheets API credentials JSON file
GOOGLE_SHEETS_CREDENTIALS=credentials/google-sheets-credentials.json

# The ID of your Google Spreadsheet (from the URL)
# Example: If URL is https://docs.google.com/spreadsheets/d/1ABC123xyz/edit
# Then the ID is: 1ABC123xyz
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# ------------------------------------------------------------
# Earnings Whispers (https://www.earningswhispers.com)
# ------------------------------------------------------------
# Used by: scripts/fetch_earnings_calendar.py (--source ew or --source all)
# Purpose: Fetch options strategy picks (Long Calls, Bull Spreads, etc.)
# Requires a paid Earnings Whispers subscription
EW_USER=your_earningswhispers_email
EW_PASS=your_earningswhispers_password

# ------------------------------------------------------------
# Unusual Whales API (Public endpoints - no key required)
# ------------------------------------------------------------
# The following APIs are used but don't require authentication:
# - Trading Calendar: https://phx.unusualwhales.com/api/trading-calendar
# - Earnings Calendar: https://phx.unusualwhales.com/api/companies_earnings/upcoming_earnings_v2
# Note: User-Agent headers are required to prevent blocking

# ------------------------------------------------------------
# Yahoo Finance API (Free - no key required)
# ------------------------------------------------------------
# Used by: scripts/fetch_market_data.py
# Purpose: Fetch historical OHLCV data for SPY, QQQ, IWM, SPX
# Note: Uses yfinance library which accesses Yahoo Finance's public API

# ------------------------------------------------------------
# Alpha Vantage API
# ------------------------------------------------------------
# Get your free API key from: https://www.alphavantage.co/support/#api-key
# Used by: scripts/fetch_alphavantage_intraday.py, scripts/fetch_alphavantage_options.py
# Purpose: Fetch 1-minute intraday data and historical options chains
# Rate Limits: Free tier allows 5 API calls/minute, 500 calls/day
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ------------------------------------------------------------
# Benzinga API (Catalyst Calendar)
# ------------------------------------------------------------
# Get your API key from: https://www.benzinga.com/apis/
# Used by: scripts/fetch_catalyst_calendar.py, platform/api/routers/catalysts.py
# Purpose: Fetch corporate catalyst events (earnings, guidance, M&A, FDA, ratings)
# GCP Secret: projects/28960574877/secrets/benzinga-api-key
# NOTE: Benzinga does NOT cover investor conferences, summits, production
# updates, shareholder meetings, or interim statements. Those require
# Wall Street Horizon via IBKR TWS API ($49-149/mo).
BENZINGA_API_KEY=your_benzinga_api_key_here

# ------------------------------------------------------------
# AI Insights agent pipeline (segment 1-11)
# ------------------------------------------------------------
# ADMIN_TOKEN: Required for the /api/admin/* endpoints that drive
# the model-routing dashboard. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# This token is NEVER exposed to the frontend bundle; the browser
# stores it in sessionStorage and sends it as X-Admin-Token.
ADMIN_TOKEN=generate_with_secrets_token_urlsafe_32

# Tickers the scheduled pipeline runs for (comma-separated).
# Defaults to SPY,IWM,QQQ if unset.
INSIGHT_TICKERS=SPY,IWM,QQQ

# Cloud Tasks queue and service account for on-demand runs.
# These default to sensible values; override only if your GCP
# layout differs from the one in gcp/deploy.sh.
# INSIGHT_TASKS_QUEUE=insight-pipeline-queue
# INSIGHT_TASKS_SERVICE_ACCOUNT=trading-runner@adept-mountain-474619-d4.iam.gserviceaccount.com
